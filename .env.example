# Front-end analytics. Both are PUBLIC_ and therefore inlined into the client
# bundle at build time — which is correct for both, and is why neither is a
# secret. See docs/front-end-analytics-design.md.
#
# Copy to .env for a local run. .env is gitignored; .env.example is not, so
# never put a real key in this file.

# PostHog project API key. A publishable `phc_…` project token that ships in the
# bundle and identifies the project, not the account — it is stored as a GitHub
# repository VARIABLE rather than a secret, because masking a value that is
# visible in the page source only makes CI logs harder to read.
#
# Use a SEPARATE PostHog project for anything that is not production. A local
# run or a PR preview pointed at the production project silently corrupts the
# real data, and there is no way to unmix it afterwards.
PUBLIC_POSTHOG_KEY=

# The explicit production switch. Only the exact string "true" turns analytics
# on; anything else, including absent, leaves them off.
#
# Deliberately a build-time switch rather than a hostname check. Suppressing by
# hostname would make local and preview verification impossible — you could
# never test the thing you were shipping — so enablement is something you state,
# not something the code guesses.
PUBLIC_ANALYTICS_ENABLED=false
