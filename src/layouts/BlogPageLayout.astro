---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import ContentCarousel from "../components/ContentCarousel.astro";
import ProjectLogSection from "../components/ProjectLogSection.astro";

interface Props {
  collectionName: "projects" | "mockedProjects";
  linkPrefix: string;
  headerSubtitle: string;
  logEyebrow: string;
  logTitle: string;
}

const { 
  collectionName, 
  linkPrefix, 
  headerSubtitle, 
  logEyebrow, 
  logTitle 
} = Astro.props;
---

<BaseLayout title="Workshop Journal | Built by Woodley">
  <main class="journal-page vt-blog-page">
    <div class="page-shell">
      <Header subtitle={headerSubtitle} />
    </div>

    <div class="journal-featured">
      <ContentCarousel collectionName={collectionName} />
    </div>

    <ProjectLogSection 
      eyebrow={logEyebrow} 
      title={logTitle} 
      collectionName={collectionName} 
      linkPrefix={linkPrefix}
    />
  </main>
</BaseLayout>
