---
import NavigationTransitionHead from '../components/NavigationTransitionHead.astro';
import AiSlopMark from '../components/AiSlopMark.astro';
import TopNav from '../components/TopNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ImagePerfProbe from '../components/ImagePerfProbe.astro';
import '../styles/global.css';
import '../styles/view-transitions.css';

interface Props {
  /** Hide the sticky TopNav — for full-bleed pages that supply their own navigation UI. */
  hideNav?: boolean;
  /** Hide the site footer — for full-bleed pages that own the whole window. */
  hideFooter?: boolean;
  /** Show the fixed AI-generated-content warning at the bottom of the viewport. */
  aiSlop?: boolean;
  title?: string;
  description?: string;
}

// The image probe reports what each <img> on the page actually cost this
// browser on this screen. It is a build-time switch rather than a runtime one,
// so nothing about it — markup, script or style — reaches a production build:
//   PUBLIC_IMAGE_PERF=1 npm run build && npm run preview
//
// Matched against explicit on-values rather than Boolean(): the variable comes
// through as a string, so Boolean('0') and Boolean('false') are both true and
// would have shipped the probe to production for anyone who set it to an
// off-looking value. scripts/check-asset-sizes.mjs asserts the build is clean.
const IMAGE_PERF_ON = new Set(['1', 'true', 'yes', 'on']);
const showImageProbe =
  import.meta.env.DEV ||
  IMAGE_PERF_ON.has(String(import.meta.env.PUBLIC_IMAGE_PERF ?? '').toLowerCase());

const {
  hideNav = false,
  hideFooter = false,
  aiSlop = false,
  title = 'Built by Woodley',
  description = "Stuff that I've built",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Resolve the colour theme before first paint. This script intentionally
         runs once; the transition coordinator carries its root attributes
         across ClientRouter DOM swaps. New sessions follow the system setting,
         while explicit light and dark preferences remain available. -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'theme';
        var root = document.documentElement;
        var MODES = { light: 1, dark: 1, system: 1 };
        var BG = { light: '#ede9e1', dark: '#181e21' };

        function systemTheme() {
          if (!window.matchMedia) return 'light';
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
          return 'light';
        }

        function storedMode() {
          try {
            var value = localStorage.getItem(STORAGE_KEY);
            return MODES[value] ? value : 'system';
          } catch (error) {
            return 'system';
          }
        }

        function syncCanvasBg(appliedTheme) {
          var theme = appliedTheme === 'dark' ? 'dark' : 'light';
          var background = BG[theme];
          root.style.setProperty('--vt-bg', background);
          root.style.backgroundColor = background;
          root.style.colorScheme = theme;
        }

        function applyMode(modeValue) {
          var mode = MODES[modeValue] ? modeValue : 'system';
          var applied = mode === 'light' || mode === 'dark' ? mode : systemTheme();
          root.setAttribute('data-theme', applied);
          root.setAttribute('data-theme-mode', mode);
          syncCanvasBg(applied);
        }
        window.__applyThemeMode = applyMode;

        try {
          applyMode(storedMode());
        } catch (error) {
          var fallbackTheme = 'light';
          try {
            fallbackTheme = systemTheme();
          } catch (fallbackError) {}
          root.setAttribute('data-theme', fallbackTheme);
          root.setAttribute('data-theme-mode', 'system');
          syncCanvasBg(fallbackTheme);
        }

        try {
          var media = window.matchMedia('(prefers-color-scheme: dark)');
          var onChange = function () {
            if (storedMode() !== 'system') return;
            applyMode('system');
            window.dispatchEvent(new Event('themechange'));
          };
          if (media.addEventListener) media.addEventListener('change', onChange);
          else if (media.addListener) media.addListener(onChange);
        } catch (error) {}
      })();
    </script>
    <!-- The landing page holds its title back so the reveal has somewhere to
         start from. Arming it here means it is set before first paint; the
         timeout releases it if the page script never arrives, so a hero can
         never be left invisible by a script that failed to load. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.setAttribute('data-motion-armed', '');
        setTimeout(function () {
          root.removeAttribute('data-motion-armed');
        }, 2000);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <NavigationTransitionHead />
  </head>
  <body>
    <div class="vt-page-backdrop" aria-hidden="true"></div>
    {!hideNav && <TopNav />}
    {aiSlop && <AiSlopMark floating={hideNav} />}
    <slot />
    {!hideFooter && <SiteFooter clearAiMark={aiSlop && hideNav} />}
    {showImageProbe && <ImagePerfProbe />}
    <script>
      import '../scripts/nav-scroll-visibility';
      import '../scripts/storyscroll';
      import '../scripts/home-scroll';
    </script>
  </body>
</html>
