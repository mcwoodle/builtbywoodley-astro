---
import TopNav from '../components/TopNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

const title = "Built by Woodley";
const description = "Stuff that I've built";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Apply the saved (or system-preferred) theme before first paint to
         avoid a flash of the wrong theme. Must stay inline and ahead of the
         stylesheet. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          /* If storage/matchMedia is unavailable, fall back to the light default. */
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ThemeToggle />
    <TopNav />
    <slot />
    <script>
      import '../scripts/storyscroll';
    </script>
  </body>
</html>
