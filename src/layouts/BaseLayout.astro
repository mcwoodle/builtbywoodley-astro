---
import TopNav from '../components/TopNav.astro';
import { viewTransitionAnimationConfig } from '../content.config';
import '../styles/global.css';
import '../styles/view-transitions.css';

interface Props {
  /** Hide the sticky TopNav — for full-bleed pages that supply their own
      navigation UI (e.g. the framed map's floating home tab). */
  hideNav?: boolean;
}
const { hideNav = false } = Astro.props;

const title = "Built by Woodley";
const description = "Stuff that I've built";
const viewTransitionAnimationConfigJson = JSON.stringify(viewTransitionAnimationConfig);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <script
      type="application/json"
      id="view-transition-animation-config"
      set:html={viewTransitionAnimationConfigJson}
    />
    <!-- Resolve and apply the colour theme before first paint to avoid a flash
         of the wrong theme. The visitor's saved *mode* is one of:
           • 'light' / 'dark' — an explicit fixed choice.
           • 'system'         — follow the OS/browser preference. This is the
                                default when nothing is saved.
         data-theme holds the applied colour theme (always light/dark; drives the
         CSS tokens). data-theme-mode holds the mode (drives the toggle icon).
         Must stay inline and ahead of the stylesheet. -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'theme';
        var FAMILY_KEY = 'theme-family';
        var root = document.documentElement;
        var MODES = { light: 1, dark: 1, system: 1 };
        var FAMILIES = { editorial: 1, original: 1 };
        var TRANSITION_MODES = { 'body-transform': 1, disabled: 1, native: 1 };
        var BG = {
          editorial: { light: '#FAF8F4', dark: '#15120F' },
          original: { light: '#F5F0EB', dark: '#1A1613' },
        };

        function syncCanvasBg(fam, applied) {
          var family = FAMILIES[fam] ? fam : 'editorial';
          var theme = applied === 'dark' ? 'dark' : 'light';
          var bg = BG[family][theme];
          root.style.setProperty('--vt-bg', bg);
          root.style.backgroundColor = bg;
          root.style.colorScheme = theme;
        }

        // The visitor's chosen mode. No saved value => 'system' (the default).
        function storedMode() {
          try {
            var v = localStorage.getItem(STORAGE_KEY);
            return MODES[v] ? v : 'system';
          } catch (e) {
            return 'system'; // Storage blocked (private mode, disabled cookies…).
          }
        }

        // The visitor's chosen theme family (look). No saved value =>
        // 'editorial' (the default, more refined look). 'original' restores
        // the site's original appearance.
        function storedFamily() {
          try {
            var v = localStorage.getItem(FAMILY_KEY);
            return FAMILIES[v] ? v : 'editorial';
          } catch (e) {
            return 'editorial';
          }
        }

        // Apply a family. Exposed so the family toggle reuses this exact logic.
        function applyFamily(fam) {
          var family = FAMILIES[fam] ? fam : 'editorial';
          root.setAttribute('data-theme-family', family);
          syncCanvasBg(family, root.getAttribute('data-theme') || systemTheme());
        }
        window.__applyThemeFamily = applyFamily;

        // The OS-/browser-level preference. `prefers-color-scheme` is the only
        // signal platforms expose, and it already layers OS then browser: it
        // reports the platform setting unless the browser overrides it, in
        // which case it reports that browser-level setting.
        function systemTheme() {
          if (!window.matchMedia) return 'light'; // Pre-2015 browser.
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
          if (window.matchMedia('(prefers-color-scheme: light)').matches) return 'light';
          return 'light'; // No preference exposed.
        }

        function configuredTransitionMode() {
          var config = { default: 'native', rules: [] };
          try {
            var configNode = document.getElementById('view-transition-animation-config');
            if (configNode && configNode.textContent) {
              var parsed = JSON.parse(configNode.textContent);
              if (parsed && typeof parsed === 'object') config = parsed;
            }
          } catch (err) {
            /* Malformed config should not break page rendering. */
          }

          var ua = navigator.userAgent || '';
          var rules = Array.isArray(config.rules) ? config.rules : [];
          for (var i = 0; i < rules.length; i += 1) {
            var rule = rules[i];
            if (!rule || !TRANSITION_MODES[rule.mode] || typeof rule.userAgentPattern !== 'string') {
              continue;
            }
            try {
              if (new RegExp(rule.userAgentPattern).test(ua)) return rule.mode;
            } catch (err) {
              /* Ignore invalid configured patterns. */
            }
          }

          var mode = config.default || 'native';
          return TRANSITION_MODES[mode] ? mode : 'native';
        }

        // Apply a mode: the resolved colour theme (always light/dark) plus the
        // mode itself. Exposed so the toggle reuses this exact resolution.
        function applyMode(mode) {
          var applied =
            mode === 'light' ? 'light' : mode === 'dark' ? 'dark' : systemTheme();
          root.setAttribute('data-theme', applied);
          root.setAttribute('data-theme-mode', mode);
          syncCanvasBg(root.getAttribute('data-theme-family') || storedFamily(), applied);
        }
        window.__applyThemeMode = applyMode;

        var transitionMode = configuredTransitionMode();
        root.setAttribute('data-vt-animation', transitionMode);

        function skipNativeViewTransition(event) {
          var vt = event && event.viewTransition;
          if (vt && typeof vt.skipTransition === 'function') vt.skipTransition();
        }

        // The configured "disabled" mode disables cross-document animation while
        // still allowing ordinary navigation and page rendering to proceed.
        if (transitionMode === 'disabled') {
          addEventListener('pageswap', skipNativeViewTransition, { capture: true });
          addEventListener('pagereveal', skipNativeViewTransition, { capture: true });
        }

        // The configured "body-transform" mode uses a CSS transform fallback:
        // skip the native transition, record direction before navigation, then
        // animate the next page in from that side.
        try {
          if (transitionMode === 'body-transform') {
            var BODY_TRANSFORM_TRANSITION_KEY = 'body-transform-transition';
            try {
              var pending = sessionStorage.getItem(BODY_TRANSFORM_TRANSITION_KEY);
              if (pending) {
                sessionStorage.removeItem(BODY_TRANSFORM_TRANSITION_KEY);
                if (/^(left|right|up|down)$/.test(pending)) {
                  root.setAttribute('data-vt-enter', pending);
                }
              }
            } catch (err) {
              /* Storage may be unavailable; navigation still works. */
            }

            addEventListener('pageswap', skipNativeViewTransition, { capture: true });
            addEventListener('pagereveal', skipNativeViewTransition, { capture: true });

            function normalizedPath(url) {
              var path = url.pathname.replace(/\/+$/, '');
              return path || '/';
            }

            function routePoint(path) {
              if (path === '/') return { x: 0, y: 0 };
              if (path === '/about') return { x: 0, y: 1 };
              if (path === '/software') return { x: 1, y: 0 };
              if (path.indexOf('/software/') === 0) return { x: 2, y: 0 };
              if (path === '/blog' || path === '/mocked/blog') return { x: 1, y: 0 };
              if (path.indexOf('/blog/') === 0 || path.indexOf('/mocked/blog/') === 0) {
                return { x: 2, y: 0 };
              }
              return null;
            }

            function fallbackDirection(anchor, targetUrl) {
              var from = routePoint(normalizedPath(location));
              var to = routePoint(normalizedPath(targetUrl));
              if (from && to) {
                var dx = to.x - from.x;
                var dy = to.y - from.y;
                if (Math.abs(dx) >= Math.abs(dy) && dx !== 0) return dx > 0 ? 'right' : 'left';
                if (dy !== 0) return dy > 0 ? 'down' : 'up';
              }
              if (anchor && anchor.dataset.direction === 'down') return 'down';
              return 'right';
            }

            function shouldAnimateNavigation(event, anchor, targetUrl) {
              if (event.defaultPrevented) return false;
              if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                return false;
              }
              if (!anchor || anchor.target || anchor.hasAttribute('download')) return false;
              if (targetUrl.origin !== location.origin) return false;
              if (targetUrl.pathname === location.pathname && targetUrl.search === location.search) {
                return false;
              }
              if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                return false;
              }
              return true;
            }

            addEventListener('click', function (event) {
              var anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
              if (!anchor) return;
              var targetUrl;
              try {
                targetUrl = new URL(anchor.href, location.href);
              } catch (err) {
                return;
              }
              if (!shouldAnimateNavigation(event, anchor, targetUrl)) return;

              var direction = fallbackDirection(anchor, targetUrl);
              event.preventDefault();
              root.setAttribute('data-vt-exit', direction);
              try {
                sessionStorage.setItem(BODY_TRANSFORM_TRANSITION_KEY, direction);
              } catch (err) {
                /* Ignore storage failures; the exit animation can still run. */
              }

              var finished = false;
              var go = function (animationEvent) {
                if (animationEvent && animationEvent.target !== document.body) return;
                if (finished) return;
                finished = true;
                location.href = targetUrl.href;
              };
              document.body.addEventListener('animationend', go, { once: true });
              setTimeout(go, 480);
            }, { capture: true });
          }
        } catch (e) {
          /* Transition mode setup is best-effort; unsupported environments still navigate. */
        }

        try {
          applyFamily(storedFamily());
          applyMode(storedMode());
        } catch (e) {
          // Never leave the page unstyled.
          try {
            root.setAttribute('data-theme', 'light');
            root.setAttribute('data-theme-mode', 'system');
            root.setAttribute('data-theme-family', 'editorial');
          } catch (e2) {}
        }

        // In system mode, follow live OS/browser theme changes without a reload.
        try {
          var mql = window.matchMedia('(prefers-color-scheme: dark)');
          var onChange = function () {
            if (storedMode() !== 'system') return; // A fixed choice wins.
            applyMode('system');
            try {
              window.dispatchEvent(new Event('themechange'));
            } catch (err) {
              /* Event constructor missing — purely cosmetic, ignore. */
            }
          };
          if (mql.addEventListener) mql.addEventListener('change', onChange);
          else if (mql.addListener) mql.addListener(onChange); // Older browsers.
        } catch (e) {
          /* Change events unsupported; the initial theme is still applied. */
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="vt-page-backdrop" aria-hidden="true"></div>
    {!hideNav && <TopNav />}
    <slot />
    <script>
      import '../scripts/storyscroll';
    </script>
  </body>
</html>
