---
import TopNav from '../components/TopNav.astro';
import '../styles/global.css';

const title = "Built by Woodley";
const description = "Stuff that I've built";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Resolve and apply the colour theme before first paint to avoid a flash
         of the wrong theme. Order of precedence:
           1. An explicit choice the visitor saved via the toggle (localStorage).
           2. The OS / browser preference (`prefers-color-scheme`), which already
              reflects a browser-level override layered on top of the OS setting.
           3. Light, as a last resort when nothing exposes a preference.
         Must stay inline and ahead of the stylesheet. -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'theme';
        var root = document.documentElement;

        // An explicit, visitor-made choice. Absent => follow the system.
        function storedChoice() {
          try {
            var v = localStorage.getItem(STORAGE_KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) {
            return null; // Storage blocked (private mode, disabled cookies…).
          }
        }

        // The OS-/browser-level preference. `prefers-color-scheme` is the only
        // signal platforms expose, and it already layers OS then browser: it
        // reports the OS setting (Windows, macOS, iOS, Android, ChromeOS,
        // GNOME/KDE…) unless the browser overrides it (Firefox content-override,
        // Chrome Auto Dark, per-site dark mode), in which case it reports that.
        function systemTheme() {
          if (!window.matchMedia) return 'light'; // Pre-2015 browser.
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
          if (window.matchMedia('(prefers-color-scheme: light)').matches) return 'light';
          return 'light'; // No preference exposed.
        }

        function apply(theme) {
          root.setAttribute('data-theme', theme);
        }

        try {
          apply(storedChoice() || systemTheme());
        } catch (e) {
          apply('light'); // Never leave the page unstyled.
        }

        // While no explicit choice is saved, follow live OS/browser theme
        // changes without needing a reload.
        try {
          var mql = window.matchMedia('(prefers-color-scheme: dark)');
          var onChange = function (e) {
            if (storedChoice()) return; // An explicit choice wins.
            apply(e.matches ? 'dark' : 'light');
            try {
              window.dispatchEvent(new Event('themechange'));
            } catch (err) {
              /* Event constructor missing — purely cosmetic, ignore. */
            }
          };
          if (mql.addEventListener) mql.addEventListener('change', onChange);
          else if (mql.addListener) mql.addListener(onChange); // Safari <14, old Edge.
        } catch (e) {
          /* Change events unsupported; the initial theme is still applied. */
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <TopNav />
    <slot />
    <script>
      import '../scripts/storyscroll';
    </script>
  </body>
</html>
