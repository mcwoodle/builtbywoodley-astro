---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  project: any;
  aiSlop?: boolean;
}

const { project, aiSlop = false } = Astro.props;
---

<BaseLayout title={`${project.data.title} | Built by Woodley`} aiSlop={aiSlop}>
  <main class="detail-page vt-project-page">
    <article class="detail-shell">
      <header class="detail-hero">
        <h1 class="page-heading">{project.data.title}</h1>
        {project.data.description && (
          <p class="page-subtitle">{project.data.description}</p>
        )}
      </header>

      <div class="detail-content-grid">
        <aside class="detail-aside" aria-label="Project details">
          <p class="detail-aside-label">Build profile</p>
          <dl>
            <div>
              <dt>Published</dt>
              <dd>{project.data.publishDate.toLocaleDateString()}</dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{project.data.projectType}</dd>
            </div>
          </dl>
          {project.data.tags.length > 0 && (
            <div class="tags-row detail-tags">
              {project.data.tags.map((tag: string) => (
                <span class="tag-chip">{tag}</span>
              ))}
            </div>
          )}
        </aside>

        <div class="prose detail-prose">
          <slot />
          <div class="post-end-mark" aria-hidden="true"></div>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
