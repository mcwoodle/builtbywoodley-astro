---
import BaseLayout from "./BaseLayout.astro";
import { getCollection } from "astro:content";

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  linkPrefix: string;
}

const { eyebrow, title, subtitle, linkPrefix } = Astro.props;
const collectionName = linkPrefix.includes("mocked") ? "mockedProjects" : "projects";

const projects = (await getCollection(collectionName)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title={`${title} | Built by Woodley`}>
  <main class="vt-project-index">
    <section class="section-shell">
      <div class="surface-section">
        <p class="eyebrow" style="margin-bottom: var(--space-2);">
          {eyebrow}
        </p>
        <h1 class="page-heading" style="margin-bottom: var(--space-3);">
          {title}
        </h1>
        <p class="page-subtitle" style="margin-bottom: var(--space-5);">
          {subtitle}
        </p>

        <ul class="project-list">
          {
            projects.map((project) => (
              <li class="project-list-item">
                <a href={`${linkPrefix}${project.id}`}>
                  <h2 class="project-list-title">{project.data.title}</h2>
                  <p class="project-list-meta">
                    {project.data.projectType} ·{" "}
                    {project.data.publishDate.toLocaleDateString()}
                  </p>
                  {project.data.description && (
                    <p class="project-list-desc">{project.data.description}</p>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
