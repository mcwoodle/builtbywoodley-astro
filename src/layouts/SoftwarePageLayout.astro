---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  project: any;
}

const { project } = Astro.props;
---

<BaseLayout>
  <main>
    <article class="section-shell">
      <div class="surface-section">
        <header class="project-meta" style="margin-bottom: var(--space-4);">
          <span>{project.data.publishDate.toLocaleDateString()}</span>
          {project.data.repoUrl && (
            <a href={project.data.repoUrl} target="_blank" rel="noopener" style="color: var(--color-accent);">
              View repository
            </a>
          )}
        </header>
        <h1 class="page-heading" style="margin-bottom: var(--space-3);">
          {project.data.title}
        </h1>
        {project.data.description && (
          <p class="page-subtitle" style="margin-bottom: var(--space-4);">
            {project.data.description}
          </p>
        )}
        {project.data.stack.length > 0 && (
          <div class="tags-row" style="margin-bottom: var(--space-5);">
            {project.data.stack.map((tech: string) => (
              <span class="tag-chip">{tech}</span>
            ))}
          </div>
        )}
        <div class="prose">
          <slot />
        </div>
        <div class="post-end-mark"></div>
      </div>
    </article>
  </main>
</BaseLayout>

<script is:inline>
  /* Tag "slide-right" on all transitions from detail pages so CSS
     uses the horizontal root-slide. On traversals (browser back/forward)
     also add "back-nav" to reverse the slide direction. */
  window.addEventListener('pageswap', function (e) {
    if (!e.viewTransition) return;
    e.viewTransition.types.add('slide-right');
    if (e.activation.navigationType === 'traverse') {
      e.viewTransition.types.add('back-nav');
    }
    // Add home-edge when navigating TO the homepage so the dot->house /
    // arrow-fly choreography fires on this end of a home-edge nav.
    var destPath = new URL(e.activation.entry.url).pathname;
    if (destPath === '/') e.viewTransition.types.add('home-edge');
  });

  window.addEventListener('pagereveal', function (e) {
    if (!e.viewTransition) return;
    e.viewTransition.types.add('slide-right');
    var nav = navigation.activation;
    if (nav && nav.navigationType === 'traverse') {
      e.viewTransition.types.add('back-nav');
    }
    // Add home-edge when this page was reached FROM the homepage.
    if (nav && nav.from && new URL(nav.from.url).pathname === '/') {
      e.viewTransition.types.add('home-edge');
    }
  });
</script>
