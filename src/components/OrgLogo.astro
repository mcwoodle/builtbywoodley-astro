---
// An employer's own mark, shipped as an image rather than drawn inline. The
// Waterloo crest is a component of its own because it is taken apart and built
// a layer at a time; these two are just the companies' logos, so there is
// nothing to take apart and nothing to animate beyond arriving with the row.
//
// See src/assets/logos/README.md for where each file came from.

import sandvine from '../assets/logos/sandvine.svg';
import amazon from '../assets/logos/amazon.svg';

interface Props {
  /** Which mark to show. Matches the `mark` field in the work manifest. */
  name: 'sandvine' | 'amazon';
}

const { name } = Astro.props;
const logo = { sandvine, amazon }[name];
---

<span class="org-logo" data-reveal data-ink aria-hidden="true">
  <img src={logo.src} alt="" width={logo.width} height={logo.height} loading="lazy" />
</span>

<style>
  .org-logo {
    display: block;
    /* The same width the crest takes, so the three marks make a column. */
    width: clamp(38px, 4.6vw, 54px);
    flex: 0 0 auto;
  }

  .org-logo img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
