---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const isSoftware = path === '/software' || path.startsWith('/software/');
const isAbout = path === '/about';

const crumb = path.startsWith('/software/')
  ? { label: 'Software Projects', href: '/software' }
  : path.startsWith('/blog/')
    ? { label: 'Workshop Journal', href: '/blog' }
    : path.startsWith('/mocked/blog/')
      ? { label: 'Workshop Journal', href: '/mocked/blog' }
      : null;
---

<header class="top-nav vt-top-nav">
  <nav class="nav-panel" aria-label="Primary navigation">
    <div class="nav-identity">
      <a
        href="/"
        class="brand-link"
        aria-label={isHome ? 'Built by Woodley — home' : 'Back to home'}
        aria-current={isHome ? 'page' : undefined}
      >
        <span class="brand-mark" aria-hidden="true">MW</span>
        <span class="brand-copy">
          <strong>Matt Woodley</strong>
          <small>Principal engineer</small>
        </span>
      </a>

      {crumb && (
        <div class="breadcrumb" aria-label="Breadcrumb">
          <span aria-hidden="true"></span>
          <a href={crumb.href}>{crumb.label}</a>
        </div>
      )}
    </div>

    <div class="primary-links">
      <a
        href="/software"
        class:list={{ active: isSoftware }}
        aria-current={isSoftware ? 'page' : undefined}
        data-direction="right"
      >Work</a>
      <a
        href="/about"
        class:list={{ active: isAbout }}
        aria-current={isAbout ? 'page' : undefined}
        data-direction="down"
      >About</a>
    </div>

    <div class="nav-actions">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 16px 20px 0;
    pointer-events: none;
  }

  .nav-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: 64px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 8px 10px 8px 12px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 18px;
    background: color-mix(in srgb, var(--color-surface) 84%, transparent);
    box-shadow: var(--shadow-nav);
    backdrop-filter: blur(22px) saturate(135%);
    -webkit-backdrop-filter: blur(22px) saturate(135%);
    pointer-events: auto;
  }

  .nav-identity,
  .brand-link,
  .breadcrumb,
  .primary-links,
  .nav-actions {
    display: flex;
    align-items: center;
  }

  .nav-identity {
    min-width: 0;
    gap: 14px;
  }

  .brand-link {
    min-width: 0;
    gap: 10px;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: transform 220ms var(--ease-out), background-color 200ms ease;
  }

  .brand-link:hover .brand-mark,
  .brand-link:focus-visible .brand-mark {
    transform: rotate(-4deg) scale(1.04);
    background: var(--color-accent);
  }

  .brand-copy {
    display: grid;
    line-height: 1.05;
  }

  .brand-copy strong,
  .brand-copy small {
    font-family: var(--font-display);
    white-space: nowrap;
  }

  .brand-copy strong {
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .brand-copy small {
    margin-top: 4px;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.025em;
  }

  .brand-link:focus-visible,
  .breadcrumb a:focus-visible,
  .primary-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .breadcrumb {
    min-width: 0;
    gap: 12px;
  }

  .breadcrumb span {
    width: 24px;
    height: 1px;
    background: var(--color-border-strong);
  }

  .breadcrumb a {
    overflow: hidden;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 550;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .primary-links {
    gap: 2px;
    padding: 4px;
    border-radius: 12px;
    background: var(--color-surface-alt);
  }

  .primary-links a {
    position: relative;
    padding: 8px 14px;
    border-radius: 9px;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color 180ms ease, background-color 180ms ease,
      transform 180ms var(--ease-out), box-shadow 180ms ease;
  }

  .primary-links a:hover {
    color: var(--color-text);
    transform: translateY(-1px);
  }

  .primary-links a:active {
    transform: translateY(0) scale(0.96);
  }

  .primary-links a.active {
    background: var(--color-surface-raised);
    color: var(--color-text);
    box-shadow: 0 1px 5px color-mix(in srgb, var(--color-shadow) 9%, transparent);
  }

  .nav-actions {
    justify-content: flex-end;
  }

  @media (max-width: 720px) {
    .top-nav {
      padding: 10px 10px 0;
    }

    .nav-panel {
      grid-template-columns: auto minmax(0, 1fr) auto;
      min-height: 58px;
      padding: 7px 8px;
      border-radius: 16px;
    }

    .brand-copy,
    .breadcrumb {
      display: none;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
    }

    .primary-links {
      justify-self: center;
    }

    .primary-links a {
      padding: 7px 12px;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 390px) {
    .primary-links a {
      padding-inline: 10px;
    }
  }
</style>
