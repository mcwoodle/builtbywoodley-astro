---

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const isSoftware = path === '/software' || path.startsWith('/software/');
const isPhotography = path === '/photography' || path.startsWith('/photography/');

const crumb = path.startsWith('/software/')
  ? { label: 'Software Projects', href: '/software' }
  : path.startsWith('/blog/')
    ? { label: 'Workshop Journal', href: '/blog' }
    : path.startsWith('/mocked/blog/')
      ? { label: 'Workshop Journal', href: '/mocked/blog' }
      : null;
---

<header class="top-nav vt-top-nav">
  <nav class="nav-panel" aria-label="Primary navigation">
    <div class="nav-identity">
      <a
        href="/"
        class="brand-link"
        aria-label={isHome ? 'Built by Woodley — home' : 'Back to home'}
        aria-current={isHome ? 'page' : undefined}
        data-tooltip={isHome ? "You're home" : undefined}
        data-scroll-top={isHome ? '' : undefined}
      >
        <span class="brand-mark" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m3 11 9-8 9 8"></path>
            <path d="M5 10v11h14V10"></path>
            <path d="M9 21v-7h6v7"></path>
          </svg>
        </span>
      </a>

      {crumb && (
        <div class="breadcrumb" aria-label="Breadcrumb">
          <span aria-hidden="true"></span>
          <a href={crumb.href}>{crumb.label}</a>
        </div>
      )}
    </div>

    <div class="primary-links">
      <a
        href="/software"
        class:list={{ active: isSoftware }}
        aria-current={isSoftware ? 'page' : undefined}
        data-direction="right"
      >Software</a>
      <a
        href="/photography"
        class:list={{ active: isPhotography }}
        aria-current={isPhotography ? 'page' : undefined}
        data-direction="left"
      >Photography</a>
    </div>

    <div class="nav-actions">
      <!-- About lives on the landing page now, so this is a scroll when you
           are already home and a navigation plus scroll when you are not. -->
      <a
        href="/#about"
        class="about-link"
        aria-label="About me"
        data-tooltip="About me"
      >
        <!-- Drawn to the same box and weight as the house at the other end,
             so the two tiles carry the same amount of ink. -->
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <circle cx="12" cy="7.8" r="3.7"></circle>
          <path d="M4.9 20.3a7.1 7.1 0 0 1 14.2 0"></path>
        </svg>
      </a>
    </div>
  </nav>
</header>

<script>
  // The tile for the page you are already on has nowhere to send you, so it
  // stays put: it leans, and its label says where you are. Delegated from the
  // document so the behaviour survives ClientRouter swapping the nav out.
  const HOLD_MS = 1600;
  const CURRENT = '.top-nav .brand-link[aria-current="page"], .top-nav .about-link.active';

  let timer: ReturnType<typeof setTimeout> | undefined;
  let held: Element | undefined;

  function release() {
    if (!held) return;
    held.removeAttribute('data-tooltip-open');
    held.classList.remove('is-nudged');
    held = undefined;
  }

  document.addEventListener('click', (event) => {
    // The landing page claims this click when the tile has somewhere to send
    // you — the top of a long scroll — and says so on the event. Only when it
    // has not does the tile lean and say where you already are. Reading
    // defaultPrevented here would not work: the router sets that first, for
    // its own reasons, on every same-origin link.
    if ((event as Event & { pageHandled?: boolean }).pageHandled) return;

    const target = event.target;
    if (!(target instanceof Element)) return;
    const tile = target.closest(CURRENT);
    if (!tile) return;

    event.preventDefault();
    clearTimeout(timer);
    release();

    held = tile;
    tile.setAttribute('data-tooltip-open', '');
    tile.classList.remove('is-nudged');
    // Reading the layout restarts the animation when the tile is clicked again.
    void (tile as HTMLElement).offsetWidth;
    tile.classList.add('is-nudged');
    timer = setTimeout(release, HOLD_MS);
  });
</script>
