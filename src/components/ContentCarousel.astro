---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

type Props = {
  collectionName?: "projects" | "mockedProjects";
};

const { collectionName = "projects" } = Astro.props;

const projects = (await getCollection(collectionName)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<section class="featured-section js-carousel-section">
  <div class="section-header">
    <div>
      <p class="eyebrow">Featured notes</p>
      <h2 class="section-heading">Recent builds.</h2>
    </div>
    <p>Drag to explore</p>
  </div>

  <div class="carousel-track js-carousel-track">
    {projects.map((project, index) => (
      <article class="carousel-card js-carousel-card">
        <a href={`#project-${project.id}`} class="carousel-card-link">
          {project.data.coverImage?.format !== "svg" && (
            <div
              class="carousel-card-media"
              style={`--cover-focus: ${project.data.coverFocus}; --cover-zoom: ${project.data.coverZoom};`}
            >
              <Image
                src={project.data.coverImage}
                alt=""
                widths={[420, 840]}
                sizes="(max-width: 720px) 82vw, 380px"
                loading="lazy"
              />
              <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            </div>
          )}
          <div class="carousel-card-inner">
            <div class="carousel-card-meta">
              <span>{project.data.projectType}</span>
              <span>{project.data.publishDate.toLocaleDateString()}</span>
            </div>
            <h3 class="carousel-card-title">{project.data.title}</h3>
            {project.data.description && (
              <p class="carousel-card-desc">{project.data.description}</p>
            )}
            <span class="card-action" aria-hidden="true">Read note <b>↓</b></span>
          </div>
        </a>
      </article>
    ))}
  </div>

  <div
    class="carousel-slider js-carousel-slider"
    role="scrollbar"
    aria-orientation="horizontal"
    aria-label="Scroll posts"
    hidden
  >
    <div class="carousel-slider-track">
      <div class="carousel-slider-thumb js-carousel-thumb"></div>
    </div>
  </div>
</section>

<script>
  // Minimalist slider control: reflects the carousel's horizontal scroll
  // position and lets you drag (or click) anywhere on it to scroll.
  type Carousel = { track: HTMLElement; slider: HTMLElement; thumb: HTMLElement };

  let activeController: AbortController | null = null;

  function setupSlider({ track, slider, thumb }: Carousel, signal: AbortSignal) {
    const MIN_THUMB = 28; // px — keep the handle grabbable even with many cards

    const maxScroll = () => track.scrollWidth - track.clientWidth;

    const render = () => {
      const max = maxScroll();
      if (max <= 1) {
        slider.hidden = true;
        return;
      }
      slider.hidden = false;
      const trackW = slider.clientWidth;
      const thumbW = Math.max(MIN_THUMB, (track.clientWidth / track.scrollWidth) * trackW);
      const x = (track.scrollLeft / max) * (trackW - thumbW);
      thumb.style.width = `${thumbW}px`;
      thumb.style.transform = `translateX(${x}px)`;
      slider.setAttribute("aria-valuenow", String(Math.round((track.scrollLeft / max) * 100)));
    };

    // Map a pointer x within the slider to a scroll position and apply it.
    const scrollFromPointer = (clientX: number) => {
      const rect = slider.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      track.scrollLeft = ratio * maxScroll();
    };

    let dragging = false;
    slider.addEventListener("pointerdown", (e) => {
      dragging = true;
      slider.classList.add("is-dragging");
      slider.setPointerCapture(e.pointerId);
      scrollFromPointer(e.clientX);
    }, { signal });
    slider.addEventListener("pointermove", (e) => {
      if (dragging) scrollFromPointer(e.clientX);
    }, { signal });
    const end = (e: PointerEvent) => {
      dragging = false;
      slider.classList.remove("is-dragging");
      if (slider.hasPointerCapture(e.pointerId)) slider.releasePointerCapture(e.pointerId);
    };
    slider.addEventListener("pointerup", end, { signal });
    slider.addEventListener("pointercancel", end, { signal });

    let ticking = false;
    track.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        render();
        ticking = false;
      });
    }, { signal });
    window.addEventListener("resize", render, { signal });
    render();
  }

  function setupCarousels() {
    activeController?.abort();
    activeController = new AbortController();
    const { signal } = activeController;

    document.querySelectorAll<HTMLElement>(".js-carousel-section").forEach((section) => {
      const track = section.querySelector<HTMLElement>(".js-carousel-track");
      const slider = section.querySelector<HTMLElement>(".js-carousel-slider");
      const thumb = section.querySelector<HTMLElement>(".js-carousel-thumb");
      if (track && slider && thumb) setupSlider({ track, slider, thumb }, signal);
    });
  }

  document.addEventListener("astro:before-swap", () => activeController?.abort());
  document.addEventListener("astro:page-load", setupCarousels);
  setupCarousels();
</script>
