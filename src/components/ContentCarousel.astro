---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

type Props = {
  collectionName?: "projects" | "mockedProjects";
};

const { collectionName = "projects" } = Astro.props;

const projects = (await getCollection(collectionName)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<section class="section-shell js-carousel-section">
  <div class="surface-section">
    <div class="section-header">
      <div>
        <!-- <p class="eyebrow">Latest Stuff</p> -->
        <h2 class="section-heading">Latest Stuff</h2>
        <!-- <p class="page-subtitle" style="margin: 0;">
          A quick glance at what was shipped most recently before we dive into
          the full story.
        </p> -->
      </div>
    </div>

    <div class="carousel-track js-carousel-track">
      {
        projects.map((project) => (
          <article class="surface carousel-card js-carousel-card">
            <a
              href={`#project-${project.id}`}
              class="carousel-card-link"
              style="display: block; color: inherit; text-decoration: none;"
            >
              {project.data.coverImage?.format !== "svg" && (
                <div
                  class="carousel-card-media"
                  style={`--cover-focus: ${project.data.coverFocus}; --cover-zoom: ${project.data.coverZoom};`}
                >
                  <Image
                    src={project.data.coverImage}
                    alt=""
                    widths={[320, 640]}
                    sizes="320px"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="carousel-card-inner">
                <p class="eyebrow" style="margin-bottom: var(--space-2);">
                  {project.data.projectType}
                </p>
                <h3 class="carousel-card-title">{project.data.title}</h3>
                {project.data.description && (
                  <p class="carousel-card-desc">{project.data.description}</p>
                )}
                <p class="carousel-card-date">
                  {project.data.publishDate.toLocaleDateString()}
                </p>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
