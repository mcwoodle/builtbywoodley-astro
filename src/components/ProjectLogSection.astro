---
import { getCollection } from "astro:content";
import { renderProjectContent } from "../utils/content";
import BlogEntry from "./BlogEntry.astro";

interface Props {
  eyebrow: string;
  title: string;
  linkPrefix: string;
}

const { 
  eyebrow, 
  title, 
  linkPrefix
} = Astro.props;

const collectionName = linkPrefix.includes("mocked") ? "mockedProjects" : "projects";

const projects = (await getCollection(collectionName)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const projectsWithContent = await Promise.all(
  projects.map(async (project) => ({
    project,
    Content: await renderProjectContent(project),
  }))
);
---

<div class="page-shell">
  <section class="journal-log js-projects-log">
    <header class="section-header">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="section-heading">{title}.</h2>
      </div>
      <p>{projectsWithContent.length} {projectsWithContent.length === 1 ? 'entry' : 'entries'}</p>
    </header>
    <div class="journal-log-list">
      {projectsWithContent.map(({ project, Content }) => (
        <BlogEntry project={project as any} contentOnly linkPrefix={linkPrefix}>
          <Content />
        </BlogEntry>
      ))}
    </div>
  </section>
</div>
