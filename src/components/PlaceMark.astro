---
// Where a role was, drawn rather than spelled out: the Space Needle for
// Seattle, the CN Tower for Toronto, a globe for remote. Anywhere else takes a
// pin, so a place with no landmark of its own still reads as a place.
//
// In the same line-art hand as the footer's glyphs — one weight, round caps, no
// fill — and kept to strokes that stay open at the size a role's meta line
// gives them, which is about twenty-five pixels.
//
// The name itself is on the label, and spelled out for a reader who is being
// read to rather than hovering.

interface Props {
  /** The place as the manifest writes it, which is also what the label says. */
  place: string;
}

const { place } = Astro.props;

const kind = /Seattle/i.test(place)
  ? "needle"
  : /Toronto/i.test(place)
    ? "tower"
    : /^remote$/i.test(place.trim())
      ? "globe"
      : "pin";

// Proportions taken off the buildings themselves. The Needle's saucer is about
// a third as thick as it is wide — drawing it as a flat arc, which is what a
// glyph wants to do, is what made it read as a stick figure. The Tower's pods
// sit at roughly 63% and 81% of its height with the mast above them.
//
// Weight varies with how much is packed in: the Tower carries the most, so it
// is drawn finest, or its two pods close up into one blob.
const MARKS: Record<string, { paths: string[]; weight: number }> = {
  needle: {
    paths: [
      "M6.9 21.3c1.4-4.3 2.6-6.9 3.5-8.4",
      "M17.1 21.3c-1.4-4.3-2.6-6.9-3.5-8.4",
      "M12 12.9v-1.1",
      "M4.4 10.8c2.1-2.3 13.1-2.3 15.2 0-1.9 2.5-13.3 2.5-15.2 0Z",
      "M12 8.8V2.2",
    ],
    weight: 1.5,
  },
  tower: {
    paths: [
      "M10.4 21.3c.5-4.9.8-9.1.9-12.6",
      "M13.6 21.3c-.5-4.9-.8-9.1-.9-12.6",
      "M8 10.3c.6-1.9 7.4-1.9 8 0-1 1.4-7 1.4-8 0Z",
      "M12 8.2V6.6",
      "M10.5 6.4c.3-1 2.7-1 3 0-.5.8-2.5.8-3 0Z",
      "M12 5.4V1.7",
    ],
    weight: 1.4,
  },
  // Remote is not a house — a house is where one person happens to sit, and it
  // reads as domestic rather than as an answer to "where". The line asks where
  // the work was, and the answer is anywhere, so: a globe. It also carries the
  // same weight on the line as the two landmarks beside it, which a laptop or
  // a signal fan does not.
  globe: {
    paths: [
      "M20.2 12a8.2 8.2 0 1 1-16.4 0 8.2 8.2 0 0 1 16.4 0Z",
      "M3.9 12h16.2",
      "M12 3.8c2.2 2.3 3.4 5.2 3.4 8.2s-1.2 5.9-3.4 8.2c-2.2-2.3-3.4-5.2-3.4-8.2s1.2-5.9 3.4-8.2Z",
    ],
    weight: 1.6,
  },
  pin: {
    paths: [
      "M12 20.6c3.6-4.2 5.6-7.4 5.6-10a5.6 5.6 0 1 0-11.2 0c0 2.6 2 5.8 5.6 10Z",
      "M14.1 10.4a2.1 2.1 0 1 1-4.2 0 2.1 2.1 0 0 1 4.2 0Z",
    ],
    weight: 1.8,
  },
};

const mark = MARKS[kind];
---

<span class="place" data-place={kind} data-tap-tip data-tooltip={place}>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke-width={mark.weight}
    aria-hidden="true"
    focusable="false"
  >
    {mark.paths.map((d) => <path d={d}></path>)}
  </svg>
  <span class="sr-only">{place}</span>
</span>

<style>
  .place {
    position: relative;
    display: inline-flex;
    color: var(--accent-copper);
    cursor: help;
  }

  .place svg {
    display: block;
    /* Against the meta line's own type, so it stays in step with it. */
    width: 2.4em;
    height: 2.4em;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
