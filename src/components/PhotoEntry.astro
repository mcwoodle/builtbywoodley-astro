---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Photo = CollectionEntry<"photos">["data"]["photos"][number];

type Props = {
  photo: Photo;
  /** In-page anchor. The contact-strip slice for this frame points here. */
  anchor: string;
  /** Push the frame to the right edge of the shell so the column zigzags. */
  offset?: boolean;
};

const { photo, anchor, offset = false } = Astro.props;

// UTC accessors: z.coerce.date() parses "2015-09-21" as UTC midnight, so local
// getters would shift the date back a day for anyone west of Greenwich.
const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const day = String(photo.date.getUTCDate()).padStart(2, "0");
const stamp = `${day} ${MONTHS[photo.date.getUTCMonth()]} ${photo.date.getUTCFullYear()}`;

// The plate reserves the photograph's own shape before the image loads, so
// nothing is cropped and nothing shifts.
const ratio = photo.src.width / photo.src.height;
---

<figure
  class:list={["photo-frame", offset && "photo-frame--offset"]}
  id={anchor}
  style={`--ar: ${ratio}`}
>
  <div class="photo-frame-plate">
    <Image
      src={photo.src}
      alt={photo.alt}
      class="photo-frame-image"
      widths={[480, 720, 960, 1440, 1840]}
      sizes="(max-width: 1032px) calc(100vw - 48px), 960px"
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption class="photo-frame-caption">
    <div>
      <h3 class="photo-frame-title">{photo.title}</h3>
      {photo.note && <p class="photo-frame-note">{photo.note}</p>}
    </div>
    <p class="photo-frame-meta">
      <time class="photo-frame-date" datetime={photo.date.toISOString().slice(0, 10)}>
        {stamp}
      </time>
      <span class="photo-frame-place">{photo.location}</span>
    </p>
  </figcaption>
</figure>
