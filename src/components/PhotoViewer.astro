---
// The large view. One panel serves every frame: the grid links to #<anchor>,
// and the script below fills the panel from the manifest it ships with. Because
// the open photo lives in the URL, Back closes the panel and a link to a single
// photograph works.
export type ViewerFrame = {
  anchor: string;
  alt: string;
  title: string;
  note: string;
  stamp: string;
  datetime: string;
  place: string;
  src: string;
  srcset: string;
  sizes: string;
  /**
   * The master at its own size, for the 1:1 view. This is the full-resolution
   * original Astro emits for every image() field and then references from
   * nowhere — see docs/photography-image-delivery.md. It is already deployed
   * whether or not anything points at it, so using it here costs no bytes at
   * all and turns dead weight into the one thing it is actually good for.
   */
  full: string;
  /** Intrinsic size, so the panel reserves the frame's shape before it loads. */
  width: number;
  height: number;
};

type Props = { frames: ViewerFrame[] };

const { frames } = Astro.props;
---

<dialog class="photo-viewer" aria-label="Photograph">
  <div class="photo-viewer-bar" data-photo-panel>
    <p class="photo-viewer-count" data-photo-count aria-live="polite"></p>

    <button
      type="button"
      class="photo-viewer-button photo-viewer-close"
      data-photo-close
      aria-label="Close viewer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  <figure class="photo-viewer-figure" data-photo-panel>
    {/* The steps flank the picture itself. On a touch screen they turn to point
        up and down, matching the swipe. */}
    <div class="photo-viewer-stage" data-photo-swipe>
      <button
        type="button"
        class="photo-viewer-button photo-viewer-step"
        data-photo-step="-1"
        aria-label="Previous photograph"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m14.5 5-7 7 7 7"></path>
        </svg>
      </button>

      {/* Tapping the picture opens the 1:1 view; the cursor says so. It is in
          the tab order too, so Enter reaches the same view a tap does. */}
      <img
        class="photo-viewer-image"
        data-photo-image
        data-photo-zoom-open
        tabindex="0"
        alt=""
      />

      <button
        type="button"
        class="photo-viewer-button photo-viewer-step"
        data-photo-step="1"
        aria-label="Next photograph"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m9.5 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>
    <figcaption class="photo-viewer-caption" data-photo-caption>
      <div>
        <h2 class="photo-viewer-title" data-photo-title></h2>
        <p class="photo-viewer-note" data-photo-note></p>
      </div>
      <p class="photo-viewer-meta">
        <time class="photo-viewer-date" data-photo-date></time>
        <span class="photo-viewer-place" data-photo-place></span>
      </p>
    </figcaption>
  </figure>

  {/* The 1:1 view. A separate layer rather than a transform on the picture
      above, because that element is driven by the swipe and the reveal and the
      two would fight over its transform. Full-bleed on every screen: at one
      image pixel per CSS pixel there is nothing to gain from a smaller window,
      and on a phone it is the only way the frame is worth inspecting. */}
  <div class="photo-zoom" data-photo-zoom hidden>
    <img class="photo-zoom-image" data-photo-zoom-image alt="" draggable="false" />

    <p class="photo-zoom-loading" data-photo-zoom-loading>Loading full resolution…</p>

    {/* The tap that opened this closes it again, but a tap-to-dismiss with no
        visible control is a thing people have to discover. This is the
        affordance. */}
    <button
      type="button"
      class="photo-viewer-button photo-zoom-close"
      data-photo-zoom-close
      aria-label="Close full-resolution view"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
</dialog>

<script type="application/json" data-photo-frames is:inline set:html={JSON.stringify(frames)}
></script>

<script>
  import "../scripts/photo-viewer";
</script>
