---
import type { CollectionEntry } from 'astro:content';

type Props = {
  project: CollectionEntry<'projects'>;
  /** When true, only the slot (main content) is rendered; no meta, title, description, or tags. */
  contentOnly?: boolean;
};

const { project, contentOnly = false } = Astro.props;
const slug = project.id;
const id = `project-${slug}`;

---

<article id={id} class="project-entry js-project-entry surface">
  {!contentOnly && (
    <>
      <header class="project-meta">
        <span>{project.data.projectType}</span>
        <span>{project.data.publishDate.toLocaleDateString()}</span>
      </header>
      <h2 class="m-0 mb-2 text-[1.15rem]">
        <a
          href={`/projects/${slug}`}
          class="text-inherit no-underline"
        >
          {project.data.title}
        </a>
      </h2>
      {project.data.description && (
        <p class="m-0 mb-3 text-[#a1a1b0]">
          {project.data.description}
        </p>
      )}
      {project.data.tags.length > 0 && (
        <div class="tags-row mb-3">
          {project.data.tags.map((tag) => (
            <span class="tag-chip">{tag}</span>
          ))}
        </div>
      )}
    </>
  )}
  <slot />
</article>

