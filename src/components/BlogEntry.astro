---
import type { CollectionEntry } from "astro:content";

type Props = {
  project: CollectionEntry<"projects"> | CollectionEntry<"mockedProjects">;
  /** When true, only the slot (main content) is rendered; no meta, title, description, or tags. */
  contentOnly?: boolean;
  /** Base URL for project links. Defaults to production blog path. */
  linkPrefix?: string;
};

const { project, contentOnly = false, linkPrefix = "/blog/projects/" } = Astro.props;
const slug = project.id;
const id = `project-${slug}`;
---

<article id={id} class="project-entry js-project-entry">
  {
    !contentOnly && (
      <>
        <header class="project-meta">
          <span>{project.data.projectType}</span>
          <span>{project.data.publishDate.toLocaleDateString()}</span>
        </header>
        <h2 class="project-title">
          <a href={`${linkPrefix}${slug}`}>{project.data.title}</a>
        </h2>
        {project.data.description && (
          <p class="project-description">{project.data.description}</p>
        )}
        {project.data.tags.length > 0 && (
          <div class="tags-row" style="margin-bottom: var(--space-3);">
            {project.data.tags.map((tag) => (
              <span class="tag-chip">{tag}</span>
            ))}
          </div>
        )}
      </>
    )
  }
  <slot />
</article>
