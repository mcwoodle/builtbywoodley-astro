---
import type { CollectionEntry } from 'astro:content';

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const slug = project.slug;
const id = `project-${slug}`;
---

<article id={id} class="project-entry js-project-entry surface">
  <header class="project-meta">
    <span>{project.data.projectType}</span>
    <span>{project.data.publishDate.toLocaleDateString()}</span>
  </header>
  <h2 style="margin: 0 0 var(--space-2); font-size: 1.15rem;">
    {project.data.title}
  </h2>
  {project.data.description && (
    <p style="margin: 0 0 var(--space-3); color: var(--color-text-muted);">
      {project.data.description}
    </p>
  )}
  {project.data.tags.length > 0 && (
    <div class="tags-row" style="margin-bottom: var(--space-3);">
      {project.data.tags.map((tag) => (
        <span class="tag-chip">{tag}</span>
      ))}
    </div>
  )}
  <slot />
</article>

