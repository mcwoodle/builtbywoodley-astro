---
// A button in the top nav that cycles the colour theme between three modes:
// System (follow the OS/browser preference — the default), Light, and Dark.
// The active mode is shown by the icon and explained by a hover/focus tooltip.
// The theme is applied by setting data-theme (colours) and data-theme-mode
// (icon) on <html>; the no-flash init in BaseLayout's <head> sets both before
// first paint so the correct theme and icon show immediately.
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Theme: System (matches your device). Click to change."
  data-tooltip="System theme · matches your device"
>
  <!-- System mode: follow the OS/browser preference (a monitor). -->
  <svg
    class="icon-system"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
    <line x1="8" y1="21" x2="16" y2="21"></line>
    <line x1="12" y1="17" x2="12" y2="21"></line>
  </svg>
  <!-- Light mode (a sun). -->
  <svg
    class="icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <!-- Dark mode (a moon). -->
  <svg
    class="icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  type Mode = 'system' | 'light' | 'dark';

  const STORAGE_KEY = 'theme';
  const ORDER: Mode[] = ['system', 'light', 'dark'];
  const META: Record<Mode, { tip: string; label: string }> = {
    system: {
      tip: 'System theme · matches your device',
      label: 'Theme: System (matches your device). Click to change.',
    },
    light: {
      tip: 'Light theme',
      label: 'Theme: Light. Click to change.',
    },
    dark: {
      tip: 'Dark theme',
      label: 'Theme: Dark. Click to change.',
    },
  };

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  function currentMode(): Mode {
    const m = root.getAttribute('data-theme-mode');
    return m === 'light' || m === 'dark' ? m : 'system';
  }

  function applyMode(mode: Mode) {
    // Reuse the no-flash init's resolver so the system→light/dark mapping lives
    // in one place; fall back to a direct set if it is somehow unavailable.
    const apply = (
      window as unknown as { __applyThemeMode?: (m: string) => void }
    ).__applyThemeMode;
    if (apply) {
      apply(mode);
    } else {
      root.setAttribute('data-theme-mode', mode);
      if (mode === 'light' || mode === 'dark') root.setAttribute('data-theme', mode);
    }
  }

  function syncButton() {
    const meta = META[currentMode()];
    toggle?.setAttribute('aria-label', meta.label);
    toggle?.setAttribute('data-tooltip', meta.tip);
  }

  syncButton();

  // Cycle System → Light → Dark → System, recording the choice so it sticks.
  toggle?.addEventListener('click', () => {
    const next = ORDER[(ORDER.indexOf(currentMode()) + 1) % ORDER.length];
    applyMode(next);
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Storage unavailable (e.g. private mode); the mode still applies here.
    }
    syncButton();
  });

  // The no-flash init dispatches `themechange` when it live-follows an OS/browser
  // switch in system mode — keep the button's label/tooltip in sync.
  window.addEventListener('themechange', syncButton);

  // Keep other open tabs consistent when the mode changes in one of them.
  window.addEventListener('storage', (event) => {
    if (event.key !== STORAGE_KEY) return;
    const v = event.newValue;
    if (v === 'system' || v === 'light' || v === 'dark') {
      applyMode(v);
      syncButton();
    }
  });
</script>
