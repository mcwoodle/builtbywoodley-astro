---
const siteTitle = "Workshop Journal";
const siteSubtitle =
  "A scrolling log of builds, setups, and experiments — told as a single continuous story.";
---

<header class="section-shell">
  <div class="surface section-inner">
    <div class="pill">
      <span class="pill-dot" aria-hidden="true"></span>
      <span>Personal build log</span>
    </div>
    <h1 class="page-heading">{siteTitle}</h1>
    <p class="page-subtitle">
      {siteSubtitle}
    </p>
  </div>
</header>
