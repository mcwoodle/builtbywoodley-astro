---
type Props = {
  subtitle: string;
};

const { subtitle } = Astro.props;
const siteTitle = "Built by Woodley";
---

<header class="section-shell">
  <div class="surface-section">
    <div class="pill">
      <!-- vt-craft-arrow: where the homepage tag's arrow lands when the
           view transition flies it up into this pill (view-transitions.css) -->
      <span class="pill-dot vt-craft-arrow" aria-hidden="true"></span>
      <span>Personal build log</span>
    </div>
    <h1 class="page-heading">{siteTitle}</h1>
    <p class="page-subtitle">
      {subtitle}
    </p>
  </div>
</header>
