---
const siteTitle = "Built by Woodley";
const siteSubtitle =
  "Stuff that I've made, with pictures or a video to go with it.";
---

<header class="section-shell">
  <div class="surface-section">
    <div class="pill">
      <span class="pill-dot" aria-hidden="true"></span>
      <span>Personal build log</span>
    </div>
    <h1 class="page-heading">{siteTitle}</h1>
    <p class="page-subtitle">
      {siteSubtitle}
    </p>
  </div>
</header>
