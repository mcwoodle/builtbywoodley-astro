---
// The site's sign-off. BaseLayout renders it beneath every route, so a new page
// inherits the footer without asking for it — see `hideFooter` there for the
// full-bleed exceptions. Email and LinkedIn are glyphs rather than words so the
// whole line still fits across a phone without wrapping.

interface Props {
  /** Reserve room above the fixed AI-slop mark so it never lands on the links. */
  clearAiMark?: boolean;
}

const { clearAiMark = false } = Astro.props;
---

<footer class:list={["site-footer", { "site-footer--clear-mark": clearAiMark }]}>
  <p>Built in Canada.</p>
  <div>
    <a
      class="site-footer-icon"
      href="mailto:matt@builtbywoodley.ca"
      aria-label="Email Matt Woodley"
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="14" rx="3.5"></rect>
        <path d="m4.6 8.2 6.2 4.5a2 2 0 0 0 2.4 0l6.2-4.5"></path>
      </svg>
    </a>

    <a
      class="site-footer-icon"
      href="https://www.linkedin.com/in/mattwoodley"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Matt Woodley on LinkedIn — opens in a new tab"
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="4.5"></rect>
        <path d="M7.7 7.6h.01"></path>
        <path d="M7.7 10.8v5.6"></path>
        <path d="M11.9 16.4v-5.6"></path>
        <path d="M11.9 13.4a2.6 2.6 0 0 1 5.2 0v3"></path>
      </svg>
    </a>

    <span>© 2026</span>
  </div>
</footer>
