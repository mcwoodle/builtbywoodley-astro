---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Photo = CollectionEntry<"photos">["data"]["photos"][number];

type Props = {
  photo: Photo;
  /** Anchor for this frame. Opening the viewer navigates to it. */
  anchor: string;
  /** The first row is above the fold on most screens and must not lazy-load. */
  eager?: boolean;
};

const { photo, anchor, eager = false } = Astro.props;
---

{/* A real hash link, so the viewer is a place you can navigate to, share and
    back out of. Without JavaScript it simply jumps to the tile. The alt text
    belongs to the full picture in the viewer; here the caption names the frame
    and the image itself is decorative. */}
<li class="photo-tile" id={anchor}>
  <a class="photo-tile-link" href={`#${anchor}`} data-photo-open>
    <span class="photo-tile-plate">
      <Image
        src={photo.src}
        alt=""
        class="photo-tile-image"
        style={`--focus: ${photo.focus}`}
        widths={[360, 480, 720, 960]}
        sizes="(max-width: 620px) 44vw, (max-width: 1000px) 46vw, 360px"
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "auto" : "async"}
      />
    </span>
    <span class="photo-tile-caption">
      <span class="photo-tile-title">{photo.title}</span>
      <span class="photo-tile-place">{photo.location}</span>
    </span>
  </a>
</li>
