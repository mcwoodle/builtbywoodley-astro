---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found | Built by Woodley">
  <main class="page-shell not-found-page">
    <article class="not-found-card">
      <p class="eyebrow">Error · 404</p>
      <h1 class="page-heading">This page took a different route.</h1>
      <p class="page-subtitle">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="button button--primary">Return home <span aria-hidden="true">↗</span></a>

        <!-- Developer details section (hidden by default unless JS populates it) -->
        <details id="dev-details" class="developer-details" style="display: none;">
          <summary>Developer info</summary>
          <div>
            <p><strong>Requested path:</strong> <span id="error-path"></span></p>
            <p><strong>Error code:</strong> <span id="error-code">None</span></p>
            <p><strong>Resource:</strong> <span id="error-resource">N/A</span></p>
          </div>
        </details>
    </article>
  </main>
</BaseLayout>

<script>
  function showErrorDetails() {
    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');
    const resource = params.get('resource');
    
    const devDetailsEl = document.getElementById('dev-details');
    const pathEl = document.getElementById('error-path');
    const codeEl = document.getElementById('error-code');
    const resourceEl = document.getElementById('error-resource');
    
    // Always show the path that was requested
    if (pathEl) {
      // If we were redirected here, the path might be different than the original.
      // But if we landed here natively via Astro's 404 handling, pathname is the failed path.
      pathEl.textContent = window.location.pathname;
    }
    
    let hasDevInfo = false;
    
    if (code) {
      if (codeEl) codeEl.textContent = code;
      hasDevInfo = true;
    }
    
    if (resource) {
      if (resourceEl) resourceEl.textContent = resource;
      hasDevInfo = true;
    }
    
    // If we're in development mode (localhost) or we have explicit error params, show the details box
    if (devDetailsEl && (hasDevInfo || window.location.hostname === 'localhost')) {
      devDetailsEl.style.display = 'block';
    }
  }

  document.addEventListener('astro:page-load', showErrorDetails);
  showErrorDetails();
</script>
