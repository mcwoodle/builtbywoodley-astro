---
import ProjectPageLayout from "../../../../layouts/ProjectPageLayout.astro";
import { getProjectPaths, renderProjectContent } from "../../../../utils/content";

export async function getStaticPaths() {
  return getProjectPaths("mockedProjects");
}

const { project } = Astro.props;

if (!project) {
  return Astro.redirect(`/404?code=PROJECT_NOT_FOUND`);
}

const Content = await renderProjectContent(project);
---

<ProjectPageLayout project={project} aiSlop>
  <Content />
</ProjectPageLayout>
