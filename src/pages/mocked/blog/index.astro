---
import BlogPageLayout from "../../../layouts/BlogPageLayout.astro";
// Opts this page into the home ↔ blog slide transition (the homepage imports
// the same sheet; cross-document view transitions need both ends to opt in).
import "../../../styles/view-transitions.css";
---

<BlogPageLayout
  collectionName="mockedProjects"
  linkPrefix="/mocked/blog/projects/"
  headerSubtitle="Mocked test content (AI slop) just to play around with a hypothetical blog like it's 2010.
  Created using a random combination of Cursor, Claude Code CLI & VS Code Plugin, Antigravity IDE, Gemini CLI, etc. with the latest LLMs,
  just 'cause.
  "
  logEyebrow="Fake Blog Entries"
  logTitle=""
/>

<script is:inline>
  /* Tag "slide-right" on all transitions from the blog page so CSS
     uses the horizontal root-slide. On traversals (browser back/forward)
     also add "back-nav" to reverse the slide direction. */
  document.addEventListener('pageswap', function (e) {
    if (!e.viewTransition) return;
    e.viewTransition.types.add('slide-right');
    if (e.activation.navigationType === 'traverse') {
      e.viewTransition.types.add('back-nav');
    }
  });

  document.addEventListener('pagereveal', function (e) {
    if (!e.viewTransition) return;
    e.viewTransition.types.add('slide-right');
    var nav = navigation.activation;
    if (nav && nav.navigationType === 'traverse') {
      e.viewTransition.types.add('back-nav');
    }
  });
</script>
