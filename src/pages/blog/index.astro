---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ContentCarousel from "../components/ContentCarousel.astro";
import ProjectLogSection from "../components/ProjectLogSection.astro";

const collectionName = "projects";
---

<BaseLayout>
  <main class="home-main">
    <div class="main-inner">
      <Header subtitle="Stuff that I've made, with pictures or a video to go with it." />
    </div>

    <div class="carousel-wrapper">
      <ContentCarousel collectionName={collectionName} />
    </div>

    <ProjectLogSection 
      eyebrow="Full story" 
      title="Project log" 
      collectionName={collectionName} 
    />
  </main>
</BaseLayout>
