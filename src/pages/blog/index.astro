---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ContentCarousel from "../components/ContentCarousel.astro";
import BlogEntry from "../components/BlogEntry.astro";
import ProjectLogSection from "../components/ProjectLogSection.astro";
import { getCollection, render as renderEntry } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

async function getContent(project: typeof projects[number]) {
  if (typeof (project as any)?.deferredRender === "function") {
    const rendered = await (project as any).deferredRender();
    return rendered.Content;
  }
  if (typeof (project as any)?.render === "function") {
    const rendered = await (project as any).render();
    return rendered.Content;
  }
  const renderedFromHelper = await renderEntry(project);
  return renderedFromHelper.Content;
}

const projectsWithContent = await Promise.all(
  projects.map(async (project) => ({
    project,
    Content: await getContent(project),
  }))
);
---

<BaseLayout>
  <main class="home-main">
    <div class="main-inner">
      <Header subtitle="Stuff that I've made, with pictures or a video to go with it." />
    </div>

    <div class="carousel-wrapper">
      <ContentCarousel projects={projects.slice(0, 5)} />
    </div>

    <ProjectLogSection eyebrow="Full story" title="Project log">
      {
        projectsWithContent.map(({ project, Content }) => (
          <BlogEntry project={project} contentOnly>
            <Content />
          </BlogEntry>
        ))
      }
    </ProjectLogSection>
  </main>
</BaseLayout>
