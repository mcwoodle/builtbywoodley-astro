---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render as renderEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;
const project = await getEntry("projects", slug);

if (!project) {
  return Astro.redirect(`/404?code=PROJECT_NOT_FOUND&resource=${slug}`);
}

let Content: any = null;

if (typeof (project as any)?.deferredRender === "function") {
  const rendered = await (project as any).deferredRender();
  Content = rendered.Content;
} else if (typeof (project as any)?.render === "function") {
  const rendered = await (project as any).render();
  Content = rendered.Content;
}

// Fallback: use astro:content `render()` helper if no local renderer was found.
if (Content === null) {
  const renderedFromHelper = await renderEntry(project);
  Content = renderedFromHelper.Content;
}
---

<BaseLayout>
  <main>
    <article class="section-shell">
      <div class="surface-section">
        <header class="project-meta" style="margin-bottom: var(--space-4);">
          <span>{project.data.projectType}</span>
          <span>{project.data.publishDate.toLocaleDateString()}</span>
        </header>
        <h1 class="page-heading" style="margin-bottom: var(--space-3);">
          {project.data.title}
        </h1>
        {
          project.data.description && (
            <p class="page-subtitle" style="margin-bottom: var(--space-5);">
              {project.data.description}
            </p>
          )
        }
        <div class="prose">
          <Content />
        </div>
        <div class="post-end-mark"></div>
      </div>
    </article>
  </main>
</BaseLayout>
