---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<BaseLayout>
  <main>
    <section class="section-shell">
      <div class="surface" style="padding: var(--space-5);">
        <p class="eyebrow" style="margin-bottom: var(--space-2);">
          Projects index
        </p>
        <h1 class="page-heading" style="margin-bottom: var(--space-3);">
          All projects
        </h1>
        <p class="page-subtitle" style="margin-bottom: var(--space-4);">
          A crawlable index of every project entry, each with its own URL.
        </p>

        <ul style="list-style: none; padding: 0; margin: 0;">
          {projects.map((project) => (
            <li
              style="margin-bottom: var(--space-3); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border-subtle);"
            >
              <a
                href={`/projects/${project.slug}`}
                style="color: inherit; text-decoration: none; display: block;"
              >
                <h2
                  style="margin: 0 0 var(--space-1); font-size: 1.05rem;"
                >
                  {project.data.title}
                </h2>
                <p
                  style="margin: 0 0 var(--space-1); font-size: 0.8rem; color: var(--color-text-muted);"
                >
                  {project.data.projectType} ·{' '}
                  {project.data.publishDate.toLocaleDateString()}
                </p>
                {project.data.description && (
                  <p
                    style="margin: 0; font-size: 0.9rem; color: var(--color-text-muted);"
                  >
                    {project.data.description}
                  </p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

