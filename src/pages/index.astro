---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="landing-page">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="hero-copy">
        <h1 id="landing-title" class="page-heading hero-title">
          Matt<br /><span class="hero-title-name">Woodley</span>
        </h1>
        <p class="hero-summary">
          Principal software engineer turning ambiguous problems into useful,
          durable systems—and helping teams do their best work along the way.
        </p>
        <div class="role-line vt-tagline" aria-label="Builder, mentor, father">
          <span>Builder</span>
          <span>Mentor</span>
          <span>Father</span>
        </div>
      </div>

      <nav class="route-grid" aria-label="Featured pages">
        <a class="route-card route-card--work" href="/software" data-direction="right">
          <div class="route-card-meta">
            <span>01</span>
            <span class="route-card-label">
              <span class="status-dot" aria-hidden="true"></span>
              Selected work
            </span>
          </div>
          <div class="route-card-copy">
            <h2>Software projects</h2>
            <p>Systems, integrations, and tools built around real constraints.</p>
          </div>
          <span class="route-card-arrow" aria-hidden="true">↗</span>
        </a>

        <a class="route-card route-card--about" href="/about" data-direction="down">
          <div class="route-card-meta">
            <span>02</span>
            <span>Background</span>
          </div>
          <div class="route-card-copy">
            <h2>About me</h2>
            <p>How I approach leadership, craft, mentorship, and life beyond work.</p>
          </div>
          <span class="route-card-arrow" aria-hidden="true">↘</span>
        </a>
      </nav>
    </section>

    <footer class="landing-footer">
      <p>Built with intention in Canada.</p>
      <div>
        <a href="mailto:matt@builtbywoodley.ca">Email</a>
        <a href="https://www.linkedin.com/in/mattwoodley" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <span>© 2026</span>
      </div>
    </footer>
  </main>
</BaseLayout>
