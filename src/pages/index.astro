---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/view-transitions.css";
---

<BaseLayout>
  <main class="vt-home-hero" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; text-align: center; padding-top: 0; padding-bottom: 0;">
    <h1 class="page-heading" style="margin-bottom: var(--space-2); font-size: clamp(3rem, 8vw, 5rem);">Matt Woodley</h1>
    <p class="page-subtitle" style="margin-top: 0; margin-bottom: var(--space-5); font-family: var(--font-display); font-size: clamp(1rem, 2vw, 1.25rem); letter-spacing: 0.05em; color: var(--color-text-muted);">
      Builder <span style="color: var(--color-accent); opacity: 0.7; margin: 0 var(--space-2);">|</span> Mentor <span style="color: var(--color-accent); opacity: 0.7; margin: 0 var(--space-2);">|</span> Father
    </p>
    <nav class="craft-links" aria-label="Featured links">
      <a href="/mocked/blog" class="craft-link">
        <span class="craft-link-index" aria-hidden="true">01</span>
        <span>A Fake Blog</span>
        <span class="craft-link-arrow vt-craft-arrow" aria-hidden="true">→</span>
      </a>
      <a href="/about" class="craft-link">
        <span class="craft-link-index" aria-hidden="true">02</span>
        <span>About Me</span>
        <span class="craft-link-arrow js-about-arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </main>

  <div style="position: absolute; bottom: var(--space-6); left: 0; right: 0; text-align: center; padding-bottom: var(--space-4);">
    <div style="display: flex; flex-direction: column; gap: var(--space-2); align-items: center;">
      <a href="mailto:matt@builtbywoodley.ca" class="text-muted text-small" style="font-family: var(--font-display); letter-spacing: 0.05em; transition: color 0.2s ease;">
        matt@builtbywoodley.ca
      </a>
      <span class="text-muted text-xs" style="font-family: var(--font-display); opacity: 0.6; letter-spacing: 0.05em;">
        &copy; 2026 Matt Woodley
      </span>
    </div>
  </div>

  <!-- The flying arrow: vt-craft-arrow names the blog tag's arrow statically
       (view-transitions.css). When the journey is home ⇄ about instead, hand
       the name to the About tag's arrow so the morph follows the link actually
       travelled — both inner pages stage the same named landing dot in their
       header pill. pageswap fires just before the outgoing page is snapshotted
       and pagereveal just before the incoming one first renders: the only two
       moments a cross-document transition lets the names move. Browsers
       missing the events (or the Navigation API) keep the static default. -->
  <script is:inline>
    (function () {
      function aim(url) {
        var blogArrow = document.querySelector('.vt-craft-arrow');
        var aboutArrow = document.querySelector('.js-about-arrow');
        if (!blogArrow || !aboutArrow || !url) return;
        var toAbout = /^\/about\/?$/.test(new URL(url, location.href).pathname);
        // The empty string clears the inline override, falling back to the
        // stylesheet default — the blog arrow owns the name.
        blogArrow.style.viewTransitionName = toAbout ? 'none' : '';
        aboutArrow.style.viewTransitionName = toAbout ? 'craft-arrow' : '';
      }
      window.addEventListener('pageswap', function (e) {
        if (e.viewTransition && e.activation && e.activation.entry) {
          aim(e.activation.entry.url);
        }
      });
      window.addEventListener('pagereveal', function (e) {
        var act = window.navigation && window.navigation.activation;
        if (e.viewTransition && act && act.from) {
          aim(act.from.url);
        }
      });
    })();
  </script>
</BaseLayout>
