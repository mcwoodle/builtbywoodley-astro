---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; text-align: center; padding-top: 0; padding-bottom: 0;">
    <h1 class="page-heading" style="margin-bottom: var(--space-5); font-size: clamp(3rem, 8vw, 5rem);">Matt Woodley</h1>
    <nav style="display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center;">
      <a href="/mocked/blog" class="pill" style="padding: var(--space-3) var(--space-5); font-size: var(--fs-body); border-radius: var(--radius-md); transition: all 0.2s ease; border-color: var(--color-accent);">
        Mocked Blog
      </a>
      <a href="https://www.linkedin.com/in/mattwoodley" target="_blank" rel="noopener noreferrer" class="pill" style="padding: var(--space-3) var(--space-5); font-size: var(--fs-body); border-radius: var(--radius-md); transition: all 0.2s ease; border-color: var(--color-accent);">
        LinkedIn
      </a>
    </nav>
  </main>
</BaseLayout>

<style>
  a.pill:hover {
    background: var(--color-accent);
    color: white;
    transform: translateY(-2px);
  }
</style>
