---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HumanWrittenMark from "../components/HumanWrittenMark.astro";
import WaterlooMark from "../components/WaterlooMark.astro";

const softwareEntries = (await getCollection("software")).sort(
  (a, b) => a.data.order - b.data.order,
);

// The ticker is the union of every stack the case studies declare, so it stays
// true to the work without a second list to maintain.
const stack = [...new Set(softwareEntries.flatMap((entry) => entry.data.stack))];

const [photoManifest] = await getCollection("photos");
const photos = [...photoManifest.data.photos].sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
// The newest frame anchors the fold; the rest ride the horizontal strip.
const [showcase, ...strip] = photos;

const [workManifest] = await getCollection("work");
// Oldest first. The history reads forwards from the degree, so the ladder it
// draws climbs as the page comes down rather than unwinding backwards.
const roles = [...(workManifest?.data.roles ?? [])].sort((a, b) =>
  a.start.localeCompare(b.start),
);
// The co-ops come out of the main run and fold into the degree above them,
// where they belong: they are the work terms of that same programme.
const positions = roles.filter((role) => !role.internship);
const coops = roles.filter((role) => role.internship);

const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
// UTC accessors: the manifest's dates parse as UTC midnight, so local getters
// would shift them back a day for anyone west of Greenwich.
const stampFor = (date: Date) =>
  `${String(date.getUTCDate()).padStart(2, "0")} ${MONTHS[date.getUTCMonth()]} ${date.getUTCFullYear()}`;

// "2019-06" reads as "Jun 2019"; a bare year stays a bare year.
const monthYear = (value: string) => {
  if (value.length === 4) return value;
  const month = MONTHS[Number(value.slice(5, 7)) - 1];
  return month ? `${month[0]}${month.slice(1).toLowerCase()} ${value.slice(0, 4)}` : value;
};
const span = (role: { start: string; end?: string }) =>
  `${monthYear(role.start)} — ${role.end ? monthYear(role.end) : "Present"}`;

// Inclusive month counting — counting both the first and last month is what
// reproduces the figures LinkedIn shows against the same dates.
const monthsBetween = (start: string, end?: string) => {
  const startYear = Number(start.slice(0, 4));
  const startMonth = Number(start.slice(5, 7) || 1);
  const now = new Date();
  const endYear = end ? Number(end.slice(0, 4)) : now.getUTCFullYear();
  const endMonth = end ? Number(end.slice(5, 7) || 1) : now.getUTCMonth() + 1;
  return Math.max(1, (endYear - startYear) * 12 + (endMonth - startMonth) + 1);
};

const lengthOf = (total: number) => {
  const years = Math.floor(total / 12);
  const rest = total % 12;
  const parts: string[] = [];
  if (years) parts.push(`${years} yr${years === 1 ? "" : "s"}`);
  if (rest) parts.push(`${rest} mo${rest === 1 ? "" : "s"}`);
  return parts.join(" ") || "1 mo";
};

// The rungs the ladder is drawn against. A role's `level` indexes into this,
// so the word printed beside a role and its distance from the left edge are
// the same fact told twice.
const RUNGS = ["Student", "Engineer", "Engineer II", "Senior", "Principal"];

// Every position, told in terms of the one before it: the rung it came from,
// whether that was a step up, and which of the scroll motions it gets. Deriving
// the motion rather than listing it means a role added to the manifest later
// still arrives with one.
const topLevel = Math.max(...positions.map((role) => role.level), 0);
const decorated = positions.map((role, index) => {
  const previous = positions[index - 1];
  const from = previous ? previous.level : role.level;
  const rose = role.level > from;
  return {
    role,
    from,
    rose,
    // enroll   · the degree, where the whole thing starts
    // launch   · the first job out of school
    // promote  · a step up the ladder
    // summit   · the step onto the highest rung reached
    // join     · a new employer at the rung already held
    // sidestep · a new team at the same rung
    move:
      role.kind === "education"
        ? "enroll"
        : !previous || previous.kind === "education"
          ? "launch"
          : rose
            ? role.level === topLevel
              ? "summit"
              : "promote"
            : previous.company === role.company
              ? "sidestep"
              : "join",
  };
});

// Consecutive roles at one employer are one tenure. Six separate Amazon rows
// would repeat the name six times and cost six screens; this is how the
// profile they came from groups them too.
type Entry = (typeof decorated)[number];
const grouped: { company: string; entries: Entry[] }[] = [];
for (const entry of decorated) {
  const current = grouped[grouped.length - 1];
  if (current && current.company === entry.role.company) current.entries.push(entry);
  else grouped.push({ company: entry.role.company, entries: [entry] });
}

// The longest single job sets the scale every duration bar is drawn against, so
// the bars are comparable to each other rather than to nothing. The degree is
// kept out of it: five years of school would flatten every job beside it.
const longestRole = Math.max(
  1,
  ...positions
    .filter((role) => role.kind !== "education")
    .map((role) => monthsBetween(role.start, role.end)),
);

const thisYear = String(new Date().getUTCFullYear());
const tenures = grouped.map((group) => {
  const oldest = group.entries[0].role;
  const newest = group.entries[group.entries.length - 1].role;
  const education = oldest.kind === "education";
  const count = group.entries.length;
  return {
    company: group.company,
    mark: oldest.mark,
    education,
    startYear: oldest.start.slice(0, 4),
    endYear: newest.end ? newest.end.slice(0, 4) : thisYear,
    // The degree counts its work terms, since that is what sits underneath it.
    summary: `${lengthOf(monthsBetween(oldest.start, newest.end))} · ${
      education
        ? `${coops.length} co-op employers`
        : `${count} ${count === 1 ? "role" : "roles"}`
    }`,
    single: count === 1,
    // A lone role's dates are already the tenure's, in the column to the left,
    // so it carries only what that heading does not already say.
    roles: group.entries.map(({ role, from, rose, move }) => ({
      title: role.title,
      meta: (count === 1
        ? [role.location]
        : [span(role), lengthOf(monthsBetween(role.start, role.end)), role.location]
      )
        .filter(Boolean)
        .join(" · "),
      bar: Math.round((monthsBetween(role.start, role.end) / longestRole) * 100),
      note: role.note,
      move,
      from,
      level: role.level,
      rose,
      rung: RUNGS[role.level] ?? "",
      fromRung: RUNGS[from] ?? "",
      // "First role" reads truer than "Promoted" for the step off the degree.
      flag: move === "launch" ? "First role" : "Promoted",
    })),
  };
});

// The co-op strip's own range, from the first work term to the last.
const coopSpan = coops.length
  ? `${coops[0].start.slice(0, 4)} — ${(
      coops[coops.length - 1].end ?? coops[coops.length - 1].start
    ).slice(0, 4)}`
  : "";
---

<BaseLayout>
  <main class="landing-page">
    <!-- ── 1 · Title ──
         Deliberately shorter than the viewport: the photograph below breaks
         the fold, which is what asks you to keep going. No scroll arrow. -->
    <section class="chapter chapter--hero" aria-labelledby="landing-title">
      <div class="chapter-shell hero-shell">
        <p class="hero-eyebrow" data-hero-tail>Principal Software Engineer</p>

        <h1 id="landing-title" class="page-heading hero-title">
          <span class="reveal-line hero-reveal"><span>Matt</span></span>
          <span class="reveal-line hero-reveal"
            ><span class="hero-title-name">Woodley</span></span
          >
        </h1>

        <div class="hero-foot">
          <p class="hero-lead" data-hero-tail data-split-lead>
            I invent, design, implement and mentor at the organizational IC
            leadership level in Big Tech — and build things with my hands the
            rest of the time.
          </p>
          <div
            class="role-line vt-tagline"
            data-hero-tail
            aria-label="Leader, builder, father"
          >
            <span>Leader</span>
            <span>Builder</span>
            <span>Father</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 2 · The photograph ──
         Opens from a narrow rounded window to full bleed as it is scrolled
         through, with the frame drifting against the crop. -->
    <section class="showcase" aria-labelledby="showcase-caption-title">
      <figure class="showcase-frame">
        <div class="showcase-media">
          <Image
            class="showcase-image"
            src={showcase.src}
            alt={showcase.alt}
            widths={[900, 1400, 1845]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="showcase-caption">
          <span id="showcase-caption-title" class="showcase-caption-title">
            {showcase.title}
          </span>
          <span class="showcase-caption-meta">
            {showcase.location} · {stampFor(showcase.date)}
          </span>
        </figcaption>
      </figure>
    </section>

    <!-- ── 3 · Ticker ──
         Runs on its own, then leans into whichever way the page is moving. -->
    <div class="marquee" data-marquee aria-hidden="true">
      <div class="marquee-track" data-marquee-track>
        {[0, 1].map(() => (
          <div class="marquee-run">
            {stack.map((item) => (
              <span class="marquee-item">
                {item}
                <span class="marquee-sep"></span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- ── 4 · What I do ── -->
    <section class="chapter chapter--about" id="about" aria-labelledby="about-title">
      <div class="chapter-shell">
        <header class="chapter-head chapter-head--split">
          <div>
            <p class="chapter-eyebrow" data-reveal>About me</p>
            <h2 id="about-title" class="chapter-title" data-mask-title>
              <span class="reveal-line"><span>A bit about myself.</span></span>
            </h2>
          </div>
          <p class="chapter-lead" data-reveal>
            Three things, in roughly the order they matter — and then where the
            third one has taken me.
          </p>
        </header>

        <ol class="craft-list">
          <li class="craft-row" data-row>
            <span class="craft-rule" aria-hidden="true" data-row-rule></span>
            <span class="craft-glow" aria-hidden="true"></span>
            <div class="craft-lead">
              <p class="craft-index" data-row-meta>
                <span class="craft-index-num">01</span>
                <span class="craft-index-label">What matters</span>
              </p>
              <h3 class="craft-title" data-row-title>
                <span class="reveal-line"><span>Family</span></span>
              </h3>
            </div>
            <p class="craft-copy" data-split-copy>
              Above all else, my two kids, my partner, and our dog come first.
              I’ve photographed the world, but my favourite place to be now is home
              with my family.
            </p>
          </li>

          <li class="craft-row" data-row>
            <span class="craft-rule" aria-hidden="true" data-row-rule></span>
            <span class="craft-glow" aria-hidden="true"></span>
            <div class="craft-lead">
              <p class="craft-index" data-row-meta>
                <span class="craft-index-num">02</span>
                <span class="craft-index-label">Elsewhere</span>
              </p>
              <h3 class="craft-title" data-row-title>
                <span class="reveal-line"><span>Commitment to Craft</span></span>
              </h3>
            </div>
            <p class="craft-copy" data-split-copy>
              Outside of my career, I love to build stuff with my hands, from home
              renovations to "fine" wood working, and am always looking for the next skill to hone.
            </p>
          </li>

          <li class="craft-row" data-row>
            <span class="craft-rule" aria-hidden="true" data-row-rule></span>
            <span class="craft-glow" aria-hidden="true"></span>
            <div class="craft-lead">
              <p class="craft-index" data-row-meta>
                <span class="craft-index-num">03</span>
                <span class="craft-index-label">At work</span>
              </p>
              <h3 class="craft-title" data-row-title>
                <span class="reveal-line"><span>Leadership by example</span></span>
              </h3>
            </div>
            <p class="craft-copy" data-split-copy>
              I’ve excelled at the organizational IC leadership level in Big Tech,
              and thrive when inventing, designing, implementing, and mentoring.
              I am passionate about technical quality, but also about clarity: helping a
              group understand what matters, why it matters, and how to build it.
            </p>
          </li>
        </ol>

        {(positions.length > 0 || coops.length > 0) && (
          <div class="history" id="history">
            <header class="history-head">
              <p class="chapter-eyebrow" data-reveal>Work history</p>
              <h3 class="history-heading" data-mask-title>
                <span class="reveal-line"><span>How I got here.</span></span>
              </h3>
              <p class="history-legend" data-reveal>
                Forwards from the degree. The ladder on the left steps out a
                rung at every promotion.
              </p>
            </header>

            <ol class="history-list">
              {tenures.map((tenure) => (
                <li
                  class="history-row"
                  data-row
                  data-tenure
                  data-education={tenure.education ? "" : undefined}
                >
                  <span class="craft-rule" aria-hidden="true" data-row-rule></span>

                  <div class="craft-lead">
                    {tenure.mark === "uwaterloo" && <WaterlooMark />}
                    <p class="history-year" data-row-meta>
                      <span>{tenure.startYear}</span>
                      <span class="history-year-dash" aria-hidden="true"></span>
                      {/* Counts up to the year it already reads, so a tenure's
                          length is felt on the way past it. */}
                      <span data-year-count data-year-from={tenure.startYear}>
                        {tenure.endYear}
                      </span>
                    </p>
                    <h4 class="history-role" data-row-title>
                      <span class="reveal-line"><span>{tenure.company}</span></span>
                    </h4>
                    <p class="history-summary">{tenure.summary}</p>
                  </div>

                  <ol class="history-stints" data-row-body>
                    {tenure.roles.map((role) => (
                      <li
                        class="history-stint"
                        data-stint
                        data-move={role.move}
                        data-rose={role.rose ? "" : undefined}
                        style={`--from:${role.from};--to:${role.level}`}
                      >
                        {/* The ladder, in three pieces: a lead-in from the
                            tenure above, the step across to this role's own
                            rung, and the tail carrying the line on down to the
                            next role. CSS drops the two that would dangle — the
                            lead below the first role, the tail after the last.
                            Each is a faint track with a copper fill over it. */}
                        <span class="rung rung--lead" aria-hidden="true">
                          <i class="rung-fill" data-rung></i>
                        </span>
                        <span class="rung rung--step" aria-hidden="true">
                          <i class="rung-fill" data-rung></i>
                        </span>
                        <span class="rung rung--tail" aria-hidden="true">
                          <i class="rung-fill" data-tail></i>
                        </span>
                        <span class="history-node" aria-hidden="true"></span>
                        {role.rose && (
                          <span class="history-halo" aria-hidden="true" data-halo></span>
                        )}

                        <div class="history-stint-inner" data-stint-card>
                          <p class="history-rung">
                            {role.rose && (
                              <span class="history-flag" data-flag>{role.flag}</span>
                            )}
                            {role.rose ? (
                              /* The rung a promotion left rolls up out of the
                                 way and the new one takes its place. */
                              <span class="history-rung-roll" data-rung-roll>
                                <span class="history-rung-track" data-rung-track>
                                  <span aria-hidden="true">{role.fromRung}</span>
                                  <span>{role.rung}</span>
                                </span>
                              </span>
                            ) : (
                              <span class="history-rung-label">{role.rung}</span>
                            )}
                          </p>

                          <p class="history-stint-title" data-stint-title>{role.title}</p>
                          {/* Clipped, so the detail can be drawn downwards out
                              from under the title once the title has landed. */}
                          <div class="history-stint-detail" data-stint-detail>
                            <div class="history-stint-detail-inner" data-stint-detail-inner>
                              {role.meta && <p class="history-stint-meta">{role.meta}</p>}
                              {!tenure.single && (
                                <span class="history-bar" aria-hidden="true">
                                  <span
                                    class="history-bar-fill"
                                    data-bar
                                    style={`width:${role.bar}%`}
                                  ></span>
                                </span>
                              )}
                              {role.note && <p class="history-stint-note">{role.note}</p>}
                            </div>
                          </div>
                        </div>
                      </li>
                    ))}

                    {/* The co-op terms hang off the degree as one more stop on
                        its ladder: they are the work half of that programme,
                        and four full rows of their own would cost a screen. */}
                    {tenure.education && coops.length > 0 && (
                      <li
                        class="history-stint history-stint--terms"
                        data-stint
                        data-move="terms"
                        style="--from:0;--to:0"
                      >
                        {/* No lead-in of its own: the degree's tail is the
                            line that reaches down to this node. */}
                        <span class="history-node" aria-hidden="true"></span>

                        <div class="history-stint-inner" data-stint-card>
                          <p class="history-stint-title" data-stint-title>Co-op terms</p>
                          <p class="history-stint-meta">
                            {coops.length} employers · {coopSpan}
                          </p>

                          <ul class="coop-strip">
                            {coops.map((coop) => (
                              <li class="coop-term" data-coop-term>
                                <p class="coop-term-company">{coop.company}</p>
                                <p class="coop-term-span">{span(coop)}</p>
                                {coop.note && <p class="coop-term-note">{coop.note}</p>}
                              </li>
                            ))}
                          </ul>
                        </div>
                      </li>
                    )}
                  </ol>
                </li>
              ))}
            </ol>

            <a
              class="chapter-link history-link"
              href="https://www.linkedin.com/in/mattwoodley"
              target="_blank"
              rel="noopener noreferrer"
              data-reveal
              data-magnetic
            >
              Full profile on LinkedIn
              <span class="chapter-link-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" focusable="false">
                  <path d="M5 19 19 5M9 5h10v10"></path>
                </svg>
              </span>
            </a>
          </div>
        )}
      </div>
    </section>

    <!-- ── 5 · Selected work ── -->
    <section class="chapter chapter--work" id="work" aria-labelledby="work-title">
      <div class="chapter-shell">
        <header class="chapter-head chapter-head--split">
          <div>
            <p class="chapter-eyebrow" data-reveal>Selected work</p>
            <h2 id="work-title" class="chapter-title" data-mask-title>
              <span class="reveal-line"><span>Things I've built.</span></span>
            </h2>
          </div>
          <a class="chapter-link" href="/software" data-reveal data-magnetic>
            All projects
            <span class="chapter-link-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                <path d="M4 12h15M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </a>
        </header>

        <div class="work-grid">
          {softwareEntries.map((entry, index) => (
            <a class="work-card" href={entry.data.cardUrl ?? `/software/${entry.id}`}>
              <div class="work-card-media">
                <Image
                  src={entry.data.coverImage}
                  alt=""
                  width={720}
                  height={450}
                  loading="lazy"
                />
              </div>
              <div class="work-card-body">
                <p class="work-card-index">{String(index + 1).padStart(2, "0")}</p>
                <h3 class="work-card-title">{entry.data.title}</h3>
                <p class="work-card-summary">{entry.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 6 · Photography ──
         The strip is a real horizontal scroller; on a wide pointer screen the
         page pins and drives it, and everywhere else you swipe it yourself. -->
    <section class="chapter chapter--archive" id="archive" aria-labelledby="archive-title">
      {/* The heading and the strip are pinned together, so the title holds
          with its pictures instead of scrolling off above them. */}
      <div class="archive-stage" data-archive-stage>
        <div class="chapter-shell">
          <header class="chapter-head chapter-head--split">
            <div>
              <p class="chapter-eyebrow" data-reveal>Photography</p>
              <h2 id="archive-title" class="chapter-title" data-mask-title>
                <span class="reveal-line"><span>An archive of places.</span></span>
              </h2>
            </div>
            <a class="chapter-link" href="/photography" data-reveal data-magnetic>
              View the archive
              <span class="chapter-link-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" focusable="false">
                  <path d="M4 12h15M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </a>
          </header>
        </div>

        <div class="gallery" data-gallery>
          <div class="gallery-track" data-gallery-track>
            {strip.map((photo) => (
              <figure class="gallery-item">
                <div class="gallery-media">
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    widths={[420, 720]}
                    sizes="(max-width: 760px) 74vw, 34vw"
                    loading="lazy"
                  />
                </div>
                <figcaption class="gallery-caption">
                  <span class="gallery-caption-title">{photo.title}</span>
                  <span class="gallery-caption-meta">
                    {photo.location} · {stampFor(photo.date)}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── 7 · Close ── -->
    <section class="chapter chapter--contact" aria-labelledby="contact-title">
      <div class="chapter-shell">
        <p class="chapter-eyebrow" data-reveal>Elsewhere</p>
        <h2 id="contact-title" class="contact-title" data-mask-title>
          <span class="reveal-line"><span>Say hello.</span></span>
        </h2>

        <nav class="about-actions" aria-label="Contact" data-reveal>
          <a
            href="https://www.linkedin.com/in/mattwoodley"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
            data-magnetic
          >LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="mailto:matt@builtbywoodley.ca" class="button" data-magnetic>
            Email me <span aria-hidden="true">↗</span>
          </a>
        </nav>

        <HumanWrittenMark />
      </div>
    </section>
  </main>
</BaseLayout>
