---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; text-align: center; padding-top: 0; padding-bottom: 0;">
    <h1 class="page-heading" style="margin-bottom: var(--space-2); font-size: clamp(3rem, 8vw, 5rem);">Matt Woodley</h1>
    <p class="page-subtitle" style="margin-top: 0; margin-bottom: var(--space-5); font-family: var(--font-display); font-size: clamp(1rem, 2vw, 1.25rem); letter-spacing: 0.05em; color: var(--color-text-muted);">
      Builder <span style="color: var(--color-accent); opacity: 0.7; margin: 0 var(--space-2);">|</span> Mentor <span style="color: var(--color-accent); opacity: 0.7; margin: 0 var(--space-2);">|</span> Father
    </p>
    <nav style="display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center;">
      <a href="/mocked/blog" class="pill" style="padding: var(--space-3) var(--space-5); font-size: var(--fs-body); border-radius: var(--radius-md); transition: all 0.2s ease; border-color: var(--color-accent);">
        A Fake Blog
      </a>
      <a href="https://www.linkedin.com/in/mattwoodley" target="_blank" rel="noopener noreferrer" class="pill" style="padding: var(--space-3) var(--space-5); font-size: var(--fs-body); border-radius: var(--radius-md); transition: all 0.2s ease; border-color: var(--color-accent);">
        My LinkedIn
      </a>
    </nav>
  </main>
  
  <div style="position: absolute; bottom: var(--space-6); left: 0; right: 0; text-align: center; padding-bottom: var(--space-4);">
    <div style="display: flex; flex-direction: column; gap: var(--space-2); align-items: center;">
      <a href="mailto:matt@builtbywoodley.ca" class="text-muted text-small" style="font-family: var(--font-display); letter-spacing: 0.05em; transition: color 0.2s ease;">
        matt@builtbywoodley.ca
      </a>
      <span class="text-muted text-xs" style="font-family: var(--font-display); opacity: 0.6; letter-spacing: 0.05em;">
        &copy; 2026 Matt Woodley
      </span>
    </div>
  </div>
</BaseLayout>

<style>
  a.pill:hover {
    background: var(--color-accent);
    color: white;
    transform: translateY(-2px);
  }
</style>
