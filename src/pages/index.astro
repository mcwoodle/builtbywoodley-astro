---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="landing-page">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="hero-copy">
        <h1 id="landing-title" class="page-heading hero-title">
          Matt<br /><span class="hero-title-name">Woodley</span>
        </h1>
        <p class="hero-summary">
          Principal Software Engineer.
        </p>
        <div class="role-line vt-tagline" aria-label="Builder, mentor, father">
          <span>Leader</span>
          <span>Builder</span>
          <span>Father</span>
        </div>
      </div>

      <nav class="route-grid" aria-label="Featured pages">
        <a class="route-card route-card--work" href="/software" data-direction="right">
          <div class="route-card-copy">
            <h2>Software</h2>
            <p>Some side projects that I've built for fun in 2026.</p>
          </div>
          <span class="route-card-arrow" aria-hidden="true">↗</span>
        </a>

        <a class="route-card route-card--about" href="/about" data-direction="down">
          <div class="route-card-copy">
            <h2>About me</h2>
            <p>High level details of who I am.</p>
          </div>
          <span class="route-card-arrow" aria-hidden="true">↘</span>
        </a>
      </nav>
    </section>

    <footer class="landing-footer">
      <p>Built with intention in Canada.</p>
      <div>
        <a href="mailto:matt@builtbywoodley.ca">Email</a>
        <a href="https://www.linkedin.com/in/mattwoodley" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <span>© 2026</span>
      </div>
    </footer>
  </main>
</BaseLayout>
