---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HumanWrittenMark from "../components/HumanWrittenMark.astro";

const softwareEntries = (await getCollection("software")).sort(
  (a, b) => a.data.order - b.data.order,
);

// The ticker is the union of every stack the case studies declare, so it stays
// true to the work without a second list to maintain.
const stack = [...new Set(softwareEntries.flatMap((entry) => entry.data.stack))];

const [photoManifest] = await getCollection("photos");
const photos = [...photoManifest.data.photos].sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
// The newest frame anchors the fold; the rest ride the horizontal strip.
const [showcase, ...strip] = photos;

const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
// UTC accessors: the manifest's dates parse as UTC midnight, so local getters
// would shift them back a day for anyone west of Greenwich.
const stampFor = (date: Date) =>
  `${String(date.getUTCDate()).padStart(2, "0")} ${MONTHS[date.getUTCMonth()]} ${date.getUTCFullYear()}`;
---

<BaseLayout>
  <main class="landing-page">
    <!-- ── 1 · Title ──
         Deliberately shorter than the viewport: the photograph below breaks
         the fold, which is what asks you to keep going. No scroll arrow. -->
    <section class="chapter chapter--hero" aria-labelledby="landing-title">
      <div class="chapter-shell hero-shell">
        <p class="hero-eyebrow" data-hero-tail>Principal Software Engineer</p>

        <h1 id="landing-title" class="page-heading hero-title">
          <span class="reveal-line hero-reveal"><span>Matt</span></span>
          <span class="reveal-line hero-reveal"
            ><span class="hero-title-name">Woodley</span></span
          >
        </h1>

        <div class="hero-foot">
          <p class="hero-lead" data-hero-tail data-split-lead>
            I invent, design, implement and mentor at the organizational IC
            leadership level in Big Tech — and build things with my hands the
            rest of the time.
          </p>
          <div
            class="role-line vt-tagline"
            data-hero-tail
            aria-label="Leader, builder, father"
          >
            <span>Leader</span>
            <span>Builder</span>
            <span>Father</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 2 · The photograph ──
         Opens from a narrow rounded window to full bleed as it is scrolled
         through, with the frame drifting against the crop. -->
    <section class="showcase" aria-labelledby="showcase-caption-title">
      <figure class="showcase-frame">
        <div class="showcase-media">
          <Image
            class="showcase-image"
            src={showcase.src}
            alt={showcase.alt}
            widths={[900, 1400, 1845]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="showcase-caption">
          <span id="showcase-caption-title" class="showcase-caption-title">
            {showcase.title}
          </span>
          <span class="showcase-caption-meta">
            {showcase.location} · {stampFor(showcase.date)}
          </span>
        </figcaption>
      </figure>
    </section>

    <!-- ── 3 · Ticker ──
         Runs on its own, then leans into whichever way the page is moving. -->
    <div class="marquee" data-marquee aria-hidden="true">
      <div class="marquee-track" data-marquee-track>
        {[0, 1].map(() => (
          <div class="marquee-run">
            {stack.map((item) => (
              <span class="marquee-item">
                {item}
                <span class="marquee-sep"></span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- ── 4 · What I do ── -->
    <section class="chapter chapter--about" id="about" aria-labelledby="about-title">
      <div class="chapter-shell">
        <header class="chapter-head chapter-head--split">
          <div>
            <p class="chapter-eyebrow" data-reveal>About me</p>
            <h2 id="about-title" class="chapter-title">
              <span class="reveal-line"><span>A bit about myself.</span></span>
            </h2>
          </div>
          <p class="chapter-lead" data-reveal>
            Three things, in roughly the order they matter.
          </p>
        </header>

        <ol class="craft-list">
          <li class="craft-row">
            <span class="craft-rule" aria-hidden="true"></span>
            <span class="craft-glow" aria-hidden="true"></span>
            <div class="craft-lead">
              <p class="craft-index">
                <span class="craft-index-num">01</span>
                <span class="craft-index-label">At work</span>
              </p>
              <h3 class="craft-title">
                <span class="reveal-line"><span>Leadership by example</span></span>
              </h3>
            </div>
            <p class="craft-copy">
              I’ve excelled at the organizational IC leadership level in Big Tech,
              and thrive when inventing, designing, implementing, and mentoring.
              I am passionate about technical quality, but also about clarity: helping a
              group understand what matters, why it matters, and how to build it.
            </p>
          </li>

          <li class="craft-row">
            <span class="craft-rule" aria-hidden="true"></span>
            <span class="craft-glow" aria-hidden="true"></span>
            <div class="craft-lead">
              <p class="craft-index">
                <span class="craft-index-num">02</span>
                <span class="craft-index-label">Elsewhere</span>
              </p>
              <h3 class="craft-title">
                <span class="reveal-line"><span>Commitment to Craft</span></span>
              </h3>
            </div>
            <p class="craft-copy">
              Outside of my career, I love to build stuff with my hands, from home
              renovations to "fine" wood working, and am always looking for the next skill to hone.
            </p>
          </li>

          <li class="craft-row">
            <span class="craft-rule" aria-hidden="true"></span>
            <span class="craft-glow" aria-hidden="true"></span>
            <div class="craft-lead">
              <p class="craft-index">
                <span class="craft-index-num">03</span>
                <span class="craft-index-label">What matters</span>
              </p>
              <h3 class="craft-title">
                <span class="reveal-line"><span>Family</span></span>
              </h3>
            </div>
            <p class="craft-copy">
              Above all else, my two kids, my partner, and our dog come first.
              I’ve photographed the world, but my favourite place to be now is home
              with my family.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ── 5 · Selected work ── -->
    <section class="chapter chapter--work" id="work" aria-labelledby="work-title">
      <div class="chapter-shell">
        <header class="chapter-head chapter-head--split">
          <div>
            <p class="chapter-eyebrow" data-reveal>Selected work</p>
            <h2 id="work-title" class="chapter-title">
              <span class="reveal-line"><span>Things I've built.</span></span>
            </h2>
          </div>
          <a class="chapter-link" href="/software" data-reveal data-magnetic>
            All projects
            <span class="chapter-link-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                <path d="M4 12h15M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </a>
        </header>

        <div class="work-grid">
          {softwareEntries.map((entry, index) => (
            <a class="work-card" href={entry.data.cardUrl ?? `/software/${entry.id}`}>
              <div class="work-card-media">
                <Image
                  src={entry.data.coverImage}
                  alt=""
                  width={720}
                  height={450}
                  loading="lazy"
                />
              </div>
              <div class="work-card-body">
                <p class="work-card-index">{String(index + 1).padStart(2, "0")}</p>
                <h3 class="work-card-title">{entry.data.title}</h3>
                <p class="work-card-summary">{entry.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 6 · Photography ──
         The strip is a real horizontal scroller; on a wide pointer screen the
         page pins and drives it, and everywhere else you swipe it yourself. -->
    <section class="chapter chapter--archive" id="archive" aria-labelledby="archive-title">
      <div class="chapter-shell">
        <header class="chapter-head chapter-head--split">
          <div>
            <p class="chapter-eyebrow" data-reveal>Photography</p>
            <h2 id="archive-title" class="chapter-title">
              <span class="reveal-line"><span>An archive of places.</span></span>
            </h2>
          </div>
          <a class="chapter-link" href="/photography" data-reveal data-magnetic>
            View the archive
            <span class="chapter-link-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                <path d="M4 12h15M13 6l6 6-6 6"></path>
              </svg>
            </span>
          </a>
        </header>
      </div>

      <div class="gallery" data-gallery>
        <div class="gallery-track" data-gallery-track>
          {strip.map((photo) => (
            <figure class="gallery-item">
              <div class="gallery-media">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[420, 720]}
                  sizes="(max-width: 760px) 74vw, 34vw"
                  loading="lazy"
                />
              </div>
              <figcaption class="gallery-caption">
                <span class="gallery-caption-title">{photo.title}</span>
                <span class="gallery-caption-meta">
                  {photo.location} · {stampFor(photo.date)}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 7 · Close ── -->
    <section class="chapter chapter--contact" aria-labelledby="contact-title">
      <div class="chapter-shell">
        <p class="chapter-eyebrow" data-reveal>Elsewhere</p>
        <h2 id="contact-title" class="contact-title">
          <span class="reveal-line"><span>Say hello.</span></span>
        </h2>

        <nav class="about-actions" aria-label="Contact" data-reveal>
          <a
            href="https://www.linkedin.com/in/mattwoodley"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
            data-magnetic
          >LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="mailto:matt@builtbywoodley.ca" class="button" data-magnetic>
            Email me <span aria-hidden="true">↗</span>
          </a>
        </nav>

        <HumanWrittenMark />
      </div>
    </section>
  </main>
</BaseLayout>
