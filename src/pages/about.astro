---
import BaseLayout from "../layouts/BaseLayout.astro";
import HumanWrittenMark from "../components/HumanWrittenMark.astro";
---

<BaseLayout title="About | Built by Woodley">
  <main class="page-shell about-page">
    <section class="about-layout">
      <header class="about-intro">
        <h1 class="page-heading">Matt <span class="hero-title-name">Woodley</span></h1>
        <p class="page-subtitle vt-tagline">
          A bit about myself.
        </p>

        <div class="role-line" aria-label="Builder, leader, father">
          <span>Leader</span>
          <span>Builder</span>
          <span>Father</span>
        </div>

        <nav class="about-actions" aria-label="Elsewhere">
          <a
            href="https://www.linkedin.com/in/mattwoodley"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
          >LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="mailto:matt@builtbywoodley.ca" class="button">
            Email me <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>

      <div class="about-story">
        <article class="story-block">
          <p class="story-index">01 / At work</p>
          <h2>Leadership by example</h2>
          <p>
            I’ve excelled at the organizational IC leadership level in Big Tech,
            and thrive when inventing, designing, implementing, and mentoring.
            I am passionate about technical quality, but also about clarity: helping a
            group understand what matters, why it matters, and how to build it.
          </p>
        </article>

        <article class="story-block">
          <p class="story-index">02 / Elsewhere</p>
          <h2>Commitment to Craft</h2>
          <p>
            Outside of my career, I love to build stuff with my hands, from home
            renovations to "fine" wood working, and am always looking for the next skill to hone.
          </p>
        </article>

        <article class="story-block">
          <p class="story-index">03 / What matters</p>
          <h2>Family</h2>
          <p>
            Above all else, my two kids, my partner, and our dog come first.
            I’ve photographed the world, but my favourite place to be now is home
            with my family.
          </p>
        </article>
      </div>
    </section>

    <HumanWrittenMark />
  </main>
</BaseLayout>
