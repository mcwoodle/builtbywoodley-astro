---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Built by Woodley">
  <main>
    <header class="section-shell">
      <div class="surface-section">
        <h1 class="page-heading">About Me</h1>
        <p class="page-subtitle vt-tagline" style="font-family: var(--font-display); font-size: clamp(0.85rem, 1.5vw, 1rem); letter-spacing: 0.05em; color: var(--color-text-muted);">
          Builder <span style="color: var(--color-accent); opacity: 0.7; margin: 0 var(--space-1);">|</span> Mentor <span style="color: var(--color-accent); opacity: 0.7; margin: 0 var(--space-1);">|</span> Father
        </p>
      </div>
    </header>

    <section class="section-shell">
      <div class="surface-section">
        <div class="prose">
          <p>
            <span class="entry-leadin">I'm a principal software engineer </span> who has excelled at the organizational IC leadership level in Big Tech, and thrives when inventing, designing, implementing and mentoring.
          </p>
          <p>
            Outside of my career, I love to build stuff with my hands, from home renovations to "fine" wood working, and am always looking for that next skill to learn.
          </p>
          <p>
            Above all else, my two kids (2023 & 2025), my partner and dog come first.  I've travelled the world, but my favourite place to be now is home with my family.
          </p>
        </div>

        <!-- The cut list continues from the homepage's tags 01 and 02. -->
        <nav class="craft-links about-links" aria-label="Elsewhere">
          <a
            href="https://www.linkedin.com/in/mattwoodley"
            target="_blank"
            rel="noopener noreferrer"
            class="craft-link craft-link-out"
          >
            <span class="craft-link-index" aria-hidden="true">03</span>
            <span>My LinkedIn</span>
            <span class="craft-link-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="mailto:matt@builtbywoodley.ca" class="craft-link craft-link-out">
            <span class="craft-link-index" aria-hidden="true">04</span>
            <span>Email Me</span>
            <span class="craft-link-arrow" aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* The about page's tags pick up the homepage numbering (01, 02 → 03, 04)
     and sit flush with the text column rather than centered like the hero's. */
  .about-links {
    justify-content: flex-start;
    margin-top: var(--space-6);
  }

</style>
