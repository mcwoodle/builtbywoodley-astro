---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HumanWrittenMark from "../../components/HumanWrittenMark.astro";
import PhotoTile from "../../components/PhotoTile.astro";
import PhotoViewer from "../../components/PhotoViewer.astro";
import { getCollection } from "astro:content";
import { buildViewerFrames, sortPhotos, withAnchors } from "../../lib/photo-frames";

const [manifest] = await getCollection("photos");
const frames = withAnchors(sortPhotos(manifest.data.photos));
const viewerFrames = await buildViewerFrames(frames);

// The first row is above the fold on most screens, so it loads with the page.
const EAGER_TILES = 3;
---

<BaseLayout
  title="Photography | Built by Woodley"
  description="An archive of places, mostly at odd hours."
>
  <main class="photography-page">
    <div class="photo-shell">
      <h1 class="page-heading photo-title">Shots taken.</h1>
      <p class="page-subtitle photo-subtitle">by me.</p>

      <ul class="photo-gallery">
        {
          frames.map(({ photo, anchor }, position) => (
            <PhotoTile photo={photo} anchor={anchor} eager={position < EAGER_TILES} />
          ))
        }
      </ul>

      <HumanWrittenMark />
    </div>

    <PhotoViewer frames={viewerFrames} />
  </main>
</BaseLayout>
