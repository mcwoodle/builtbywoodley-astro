---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const entries = await getCollection("software");
const sorted = entries.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Software Projects | Built by Woodley">
  <main class="page-shell portfolio-page">
    <header class="page-intro portfolio-intro">
      <div>
        <h1 class="page-heading">Software projects.</h1>
      </div>
      <p class="page-subtitle">
        A closer look at the motivation, architecture, and engineering judgment
        behind systems designed to solve something specific.
      </p>
    </header>

    <section class="portfolio-grid" aria-label="Software case studies">
      {sorted.map((entry, index) => (
        <a
          href={entry.data.cardUrl ?? `/software/${entry.id}`}
          class="portfolio-card"
        >
          <article>
            <div class="portfolio-card-media">
              <Image
                src={entry.data.coverImage}
                alt={`Cover image for ${entry.data.title}`}
                width={720}
                height={450}
              />
              <span class="portfolio-card-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>

            <div class="portfolio-card-body">
              <div>
                <p class="portfolio-card-kicker">Case study</p>
                <h2
                  class="portfolio-card-title"
                  style={`view-transition-name: software-title-${entry.id};`}
                >
                  {entry.data.title}
                </h2>
                <p class="portfolio-card-summary">{entry.data.summary}</p>
              </div>

              <div class="portfolio-card-footer">
                {entry.data.stack.length > 0 && (
                  <div class="tags-row" aria-label="Technology stack">
                    {entry.data.stack.slice(0, 4).map((tech: string) => (
                      <span class="tag-chip">{tech}</span>
                    ))}
                    {entry.data.stack.length > 4 && (
                      <span class="tag-chip">+{entry.data.stack.length - 4}</span>
                    )}
                  </div>
                )}
                <span class="card-action" aria-hidden="true">View project <b>↗</b></span>
              </div>
            </div>
          </article>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
