---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Framed view of the GTA Urban Analytics kepler.gl map. The site's TopNav
// (from BaseLayout) sits above a full-bleed iframe of the standalone map at
// /viz/gta-crime-map. The iframe is here purely for *component isolation* —
// the kepler.gl app loads its own third-party libraries under the relaxed
// /viz/* CSP, kept off this page's strict CSP — and is not meant to read as a
// visually boxed embed. Same-origin framing works because /viz/* responds
// with `frame-ancestors 'self'` + `X-Frame-Options: SAMEORIGIN`, and this
// page's `default-src 'self'` permits the same-origin frame.
---

<BaseLayout>
  <main class="map-shell">
    <iframe
      class="map-frame"
      src="/viz/gta-crime-map"
      title="GTA Urban Analytics — interactive kepler.gl crime map"
      loading="eager"
      allowfullscreen
    ></iframe>
  </main>
</BaseLayout>

<style is:global>
  /* Full-bleed map: the sticky TopNav keeps its natural height and the iframe
     fills the entire window beneath it, edge to edge. This page is its own
     non-scrolling viewport. Page-scoped — Astro emits these styles only with
     this route, so the rest of the site is untouched.

     Two global.css rules are deliberately overridden here:
       • `main { max-width: 960px; margin: 0 auto; padding: ... }` — the
         centered article box that would otherwise shrink the map. The
         `.map-shell` class beats the bare `main` selector on specificity.
       • `html { scrollbar-gutter: stable }` — reserves a right-edge gutter we
         don't want when the page can't scroll. */
  html {
    height: 100%;
    overflow: hidden;
    scrollbar-gutter: auto;
  }
  body {
    height: 100%;
    margin: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .map-shell {
    flex: 1;
    min-height: 0;
    max-width: none;
    margin: 0;
    padding: 0;
  }
  .map-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
