{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "builtbywoodley",
  "compatibility_date": "2026-05-29",

  // Enable per-version preview URLs (served on *.workers.dev) so the PR
  // preview workflow (wrangler versions upload) can resolve a URL to post.
  // Independent of production, which stays on the custom domains below; this
  // is a deployment-level setting that applies on the next production deploy.
  "preview_urls": true,
  // Serve directory pages at their no-trailing-slash path with a direct 200.
  // Astro builds /foo/index.html; Cloudflare's default auto-trailing-slash
  // 307-redirects /foo -> /foo/, and that redirect makes the browser skip the
  // cross-document view transition. Every internal link in the site is
  // no-slash, so drop-trailing-slash keeps navigations redirect-free.
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    // Serve dist/404.html for paths that match no asset. Without this,
    // Workers' default is a 404 with a *null body* — so src/pages/404.astro
    // built, deployed, and was never once shown to anyone. The smoke suite
    // caught it; keep this and the assertion in platform.spec.ts together.
    "not_found_handling": "404-page"
  },
  // Serve the site on the root domain. custom_domain:true makes wrangler
  // provision the DNS record and TLS certificate on deploy, so no manual
  // DNS changes are needed.
  "routes": [
    { "pattern": "builtbywoodley.ca", "custom_domain": true },
    { "pattern": "www.builtbywoodley.ca", "custom_domain": true },
    { "pattern": "mattwoodley.ca", "custom_domain": true },
    { "pattern": "www.mattwoodley.ca", "custom_domain": true }
  ]
}
